.procedure e501_common
    PROC
    PUSHIS 0
    PUSHIX 5
    EQ
    IF _12
    COMM itfMesMngOpenWindow
    GOTO _11
_12:
    PUSHIS 1
    PUSHIX 5
    EQ
    IF _13
    COMM itfMesMngOpenWindow
    GOTO _11
_13:
    PUSHIS 2
    PUSHIX 5
    EQ
    IF _11
    COMM itfMesMngOpenWindow
    GOTO _11
_11:
    END
