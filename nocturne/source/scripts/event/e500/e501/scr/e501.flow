    itfMesMngMessage(16) /* TENGU_016 */;
    WAIT(30);
    MODEL_MOTION2(var3, 18, 0, 10, 2);
    WAIT(40);
    MODEL_A(var3, 60, 0);
    local6 = EFFECT_LOAD("/event/e500/e501/effect/e_effe01.D3P");
    EFFECT_POS(local6, SEARCH_ID("S12"));
    WAIT(15);
    local6 = EFFECT_LOAD("/event/e500/e501/effect/e_effe02.D3P");
    EFFECT_POS(local6, SEARCH_ID("S12"));
    WAIT(45);
    MODEL_CLS(var3);
    itfMesMngCloseWindow();
}

void e501_common()
{
