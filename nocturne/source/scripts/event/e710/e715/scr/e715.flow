    SE_PLAY_E(715, 109);
    WAIT(5);
    TEX_OFF(local0);
    TEX_CLS(local0);
    TEX_ON(local1);
    local4 = TEX_LOAD("/event/e710/e715/effect/e715_p017.tmx");
    TEX_SIZE(local4, 512, 512, 512, 512);
    TEX_OT(local4, 1);
    FADE_IN(1, 5);
    WAIT(5);
    itfMesMngOpenWindow();
    itfMesMngMessage(25) /* MSG_020: Tragically, he has no memory of his sin, his punishment, or even his... */;
    itfMesMngCloseWindow();
    WAIT(10);
    FADE_OUT(1, 5);
    SE_PLAY_E(715, 109);
    WAIT(5);
    TEX_OFF(local1);
    TEX_ON(local2);
    TEX_ON(local3);
    TEX_ON(local4);
    TEX_ALP(local3, 256, 0, 1);
    TEX_ALP(local4, 256, 0, 1);
    FADE_IN(1, 5);
    WAIT(5);
    WAIT(30);
    TEX_ALP(local2, 256, 0, 100);
    TEX_ALP(local3, 0, 256, 100);
    WAIT(100);
    TEX_ALP(local3, 256, 0, 80);
    TEX_ALP(local4, 0, 256, 80);
    WAIT(80);
    FADE_OUT(1, 5);
    SE_PLAY_E(715, 110);
    WAIT(5);
    TEX_CLS(local1);
    TEX_CLS(local2);
    TEX_CLS(local3);
    TEX_CLS(local4);
    WAIT(5);
    BGM_STOP();
    if (BIT_CHK(279) == 1)
    {
        FILTER_ALLOFF();
        FIELD_CLS_STOP();
        CALL_EVENT(717);
        return;
    }
    FIELD_CLS_STOP();
    LOAD_BE(715);
    FIELD_BE(715, 3);
    var1 = MODEL_BE(715, 6);
    MODEL_POS(var1, SEARCH_ID("01pos_01"));
    var2 = MODEL_BE(715, 4);
    MODEL_POS(var2, SEARCH_ID("01pos_02"));
    var6 = MODEL_BE(715, 5);
    MODEL_POS(var6, SEARCH_ID("01pos_03"));
    MODEL_SHADOW_ON(var1);
    SET_SKY(95, 1, 0);
    SET_SKY_A(0, - 100);
    SCENE_LIGHT_RGB(0, 0.8f, 0.7f, 0.7f);
    SCENE_LIGHT_DIR(0, - 0.3f, 0.4f, 0.5f);
    SCENE_AMBIENT(0, 0.2f, 0.2f, 0.1f);
    SOFTEN_BIAS(0, 5, 0);
    var8 = EFFECT_BE(715, 7);
    var9 = EFFECT_BE(715, 9);
    var10 = EFFECT_BE(715, 10);
    var11 = EFFECT_BE(715, 8);
    var12 = EFFECT_BE(715, 8);
    var13 = EFFECT_BE(715, 7);
    EFFECT_ON(var11);
    EFFECT_ON(var8);
    EFFECT_ON(var9);
    EFFECT_ON(var10);
    EFFECT_ON(var12);
    EFFECT_ON(var13);
    EFFECT_POS(var11, SEARCH_ID("01pos_04"));
    EFFECT_POS(var8, SEARCH_ID("01pos_06"));
    EFFECT_POS(var13, SEARCH_ID("01pos_07"));
    EFFECT_POS(var9, SEARCH_ID("01pos_08"));
    EFFECT_POS(var12, SEARCH_ID("01pos_05"));
    EFFECT_POS(var10, SEARCH_ID("01pos_09"));
    MODEL_LIGHT_LINK(var1, 0, SEARCH_ID("light01"));
    MODEL_MOTION2(var2, 0, 0, 0, 2);
    MODEL_MOTION2(var1, 1, 0, 0, 2);
    MODEL_MOTION2(var6, 0, 0, 0, 2);
    MODEL_OFF(var6);
    MODEL_OFF(var2);
    CAM_SEL(SEARCH_ID("01cam_14"));
    CAM_PATH_MOVE(SEARCH_ID("01cam_14"), SEARCH_ID("01cam_14_MOTION"));
    var14 = MODEL_BE(715, 11);
    var15 = MODEL_BE(715, 12);
    BLUR2_PARA(0.0f, 0.986f, 1);
    BLUR2_RGBA(118, 118, 128, 80);
    BLUR2_AREA(- 6, 26);
    BLUR2_ON(1);
    BGM_PLAY_E(715, 3);
    FADE_IN(1, 60);
    KUTISET(var1, 1, 0);
    SE_PLAY_E(715, 107);
    WAIT(80);
    itfMesMngOpenWindow();
    itfMesMngMessage(26) /* MSG_021: He is now on a journey to a new land of suffering, */;
    itfMesMngCloseWindow();
    FADE_OUT(1, 5);
    SE_PLAY_E(715, 108);
    WAIT(5);
    SE_STOP_E(715, 107);
    MODEL_OFF(var14);
    MODEL_OFF(var15);
    BLUR2_OFF(60);
    FADE_IN(1, 5);
    WAIT(5);
    WAIT(120);
    CAM_SEL(SEARCH_ID("01cam_10"));
    CAM_PATH_MOVE(SEARCH_ID("01cam_10"), SEARCH_ID("01cam_10_MOTION"));
    WAIT(20);
    itfMesMngOpenWindow();
    itfMesMngMessage(27) /* MSG_022: Do you want your life to be predestined as well, or would you rather... */;
    itfMesMngMessage(28) /* MSG_023: You can open the door ahead with the candelabrum I gave you. */;
    var3 = itfMesMngSelect(29) /* KAIWA_SEL: I will. / ...... */;
    itfMesMngCloseWindow();
    if (var3 == 0)
    {
        BIT_ON(286);
        BIT_OFF(287);
        CAM_SEL(SEARCH_ID("01cam_11"));
        CAM_PATH_MOVE(SEARCH_ID("01cam_11"), SEARCH_ID("01cam_11_MOTION"));
        itfMesMngOpenWindow();
        itfMesMngMessage(30) /* MSG_024: Then, we will be waiting in the deepest part of the Labyrinth. */;
        itfMesMngCloseWindow();
    }
    else if (var3 == 1)
    {
        CAM_SEL(SEARCH_ID("01cam_12"));
        CAM_PATH_MOVE(SEARCH_ID("01cam_12"), SEARCH_ID("01cam_12_MOTION"));
        BIT_ON(287);
        itfMesMngOpenWindow();
        itfMesMngMessage(31) /* MSG_024B: I understand that it is difficult for you to make a decision right now. */;
        itfMesMngCloseWindow();
    }
    CAM_SEL(SEARCH_ID("01cam_13"));
    CAM_PATH_MOVE(SEARCH_ID("01cam_13"), SEARCH_ID("01cam_13_MOTION"));
    itfMesMngOpenWindow();
    itfMesMngMessage(32) /* MSG_025: Until then... */;
    itfMesMngCloseWindow();
    MODEL_ON(var6);
    MODEL_ON(var2);
    MODEL_MOTION2(var6, 2, 0, 0, 2);
    MODEL_MOTION2(var2, 1, 0, 0, 2);
    SE_PLAY_E(715, 111);
    WAIT(320);
    BIT_ON(284);
    WAIT(10);
    FADE_OUT(0, 100);
    SE_STOP_E(715, 111);
    FADEOUT_E(715, 3);
    WAIT(100);
    BLUR_ALLOFF();
    FILTER_ALLOFF();
    FIELD_CLS_STOP();
    EXIT_EVENT();
}

