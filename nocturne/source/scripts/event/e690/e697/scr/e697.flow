    MODEL_MOTION2(var81, 2, 0, 0, 1);
    MODEL_MOTION2(var82, 2, 0, 0, 1);
    MODEL_MOTION2(var83, 2, 0, 0, 1);
    MODEL_MOTION2(var84, 2, 0, 0, 1);
    MODEL_MOTION2(var85, 2, 0, 0, 1);
    WAIT(50);
    itfMesMngOpenWindow();
    itfMesMngMessage(9) /* MSG_009 */;
    var3 = itfMesMngSelect(10);
    itfMesMngCloseWindow();
    if (var3 == 0)
    {
        itfMesMngOpenWindow();
        itfMesMngMessage(11) /* MSG_009_A */;
        itfMesMngCloseWindow();
        BIT_ON(89);
        POINT_ADD(3, 32);
    }
    else if (var3 == 1)
    {
        itfMesMngOpenWindow();
        itfMesMngMessage(12) /* MSG_009_B */;
        itfMesMngCloseWindow();
    }
    WAIT(25);
    itfMesMngOpenWindow();
    itfMesMngMessage(13) /* MSG_009_C */;
    itfMesMngCloseWindow();
    WAIT(10);
    FILTER2_PARA(0);
    FILTER2_RGBA(255, 255, 255, 255);
    FILTER2_ON(120);
    WAIT(80);
    itfMesMngOpenWindow();
    itfMesMngMessage(14) /* MSG_010 */;
    itfMesMngCloseWindow();
}

