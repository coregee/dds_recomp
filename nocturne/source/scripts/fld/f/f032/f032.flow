void 020_01eve_03()
{
    if (BIT_CHK(114) == 0)
    {
        if (BIT_CHK(146))
        {
            if (BIT_CHK(1651) == 0)
            {
                PAD_DISABLE();
                BIT_ON(2308);
                SET_ALLPANEL(0);
                itfMesMngOpenWindow();
                itfMesMngMessage(27) /* f032_SAMAEL00: ...Please wait. */;
                itfMesMngCloseWindow();
                FLD_BGM_FADE();
                FADE_OUT(0, 15);
                WAIT(15);
                CAM_SEL_FOVY(SEARCH_ID("01cam_03"));
                var10 = MODEL_DSP(6, 287);
                MODEL_POS(var10, SEARCH_ID("01pos_01"));
                FLD_MODEL_LIGHT(var10);
                var0 = MODEL_PLAYER();
                MODEL_POS(var0, SEARCH_ID("01pos_04"));
                FADE_IN(0, 15);
                WAIT(15);
                local150 = EFFBED_LOAD("/fld/f/bin/DEVILGEN.BED");
                EFFECT_POS(local150, SEARCH_ID("01pos_03"));
                EFFBED_START(local150, 0);
                COMM_217(0);
                WAIT(10);
                MODEL_A(var10, 0, 0.0f);
                MODEL_POS(var10, SEARCH_ID("01pos_03"));
                MODEL_A(var10, 30, 1.0f);
                WAIT(10);
                FLD_SE_PLAY(56);
                FADE_IN(1, 15);
                QUAKE_ON(10, 300);
                PAD_ACT(1, 170, 10);
                PAD_ACT(0, 1, 10);
                WAIT(30);
                FLD_BGM_PLAY(134);
                itfMesMngOpenWindow();
                itfMesMngMessage(28) /* f032_SAMAEL01: O noble Demi-fiend, I am honored to meet you! */;
                if (itfMesMngSelect(29) /* f032_SAMAEL01_SEL: Yeah, please join. / Sorry, I don't need you. */ == 0)
                {
                    CAM_SEL_FOVY(SEARCH_ID("01cam_04"));
                    if (prm_STOCK_FULL_CHECK() == 1)
                    {
                        itfMesMngMessage(34) /* f032_SAMAEL02: ......Hm? */;
                        itfMesMngCloseWindow();
                        WAIT(30);
                        FADE_OUT(1, 5);
                        WAIT(5);
                        MODEL_CLS(var10);
                        FADE_IN(1, 5);
                        WAIT(35);
                        itfMesMngOpenWindow();
                        itfMesMngMessage(33) /* f032_SAMAEL01_NO2: > Samael left. */;
                        itfMesMngCloseWindow();
                    }
                    else
                    {
                        itfMesMngMessage(30) /* f032_SAMAEL01_YES: ...Very well! I forfeit my life to you. */;
                        itfMesMngCloseWindow();
                        WAIT(30);
                        FADE_OUT(1, 5);
                        WAIT(5);
                        MODEL_CLS(var10);
                        FADE_IN(1, 5);
                        WAIT(35);
                        itfMesMngOpenWindow();
                        itfMesMngMessage(31) /* f032_SAMAEL01_YES2: > Samael has joined your party. */;
                        itfMesMngCloseWindow();
                        prm_DV_PLUS(161, 0, 0);
                    }
                }
                else
                {
                    CAM_SEL_FOVY(SEARCH_ID("01cam_04"));
                    itfMesMngMessage(32) /* f032_SAMAEL01_NO: You do not need me, you say? */;
                    itfMesMngCloseWindow();
                    WAIT(30);
                    FADE_OUT(1, 5);
                    WAIT(5);
                    MODEL_CLS(var10);
                    FADE_IN(1, 5);
                    WAIT(35);
                    itfMesMngOpenWindow();
                    itfMesMngMessage(33) /* f032_SAMAEL01_NO2: > Samael left. */;
                    itfMesMngCloseWindow();
                }
                FADE_OUT(0, 15);
                WAIT(15);
                BIT_ON(1651);
                BIT_ON(2308);
                MODEL_POS(var0, SEARCH_ID("01pos_04"));
                SET_CHASE_CAMERA();
                CAM_SEL(- 1);
                FADE_IN(0, 15);
                WAIT(15);
                FLD_BGM_FADE();
                FLD_BGM_PLAY(1);
                SET_ALLPANEL(1);
                PAD_ENABLE();
            }
        }
    }
}

