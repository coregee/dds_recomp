void 006_start()
{
    local38 = MODEL_DSP(6, 94);
    MODEL_POS(local38, SEARCH_ID("01pos_11"));
    FLD_MODEL_LIGHT(local38);
    FLD_NPC_OFF(0, 0, "npc_hoji_01");
    if (BIT_CHK(26) == 1 && BIT_CHK(263) == 0)
    {
        FLD_NPC_ON(0, 0, "npc_hoji_01");
    }
    else if (BIT_CHK(26) == 1 && BIT_CHK(263) == 1)
    {
        FLD_NPC_OFF(0, 0, "npc_hoji_01");
    }
    if (BIT_CHK(22) == 0)
    {
        FLD_MODEL_OFF(0, 6, "md_hoji_01", 0);
    }
    else
    {
        FLD_MODEL_ON(0, 6, "md_hoji_01", 0);
    }
    if (BIT_CHK(62) == 1)
    {
        FLD_MODEL_OFF(0, 6, "md_hoji_01", 0);
    }
    if (BIT_CHK(1344) == 0)
    {
        PAD_DISABLE();
        SET_ALLPANEL(0);
        FLD_TITLE_START2(23, 0);
        CAM_SEL(SEARCH_ID("01cam_01"));
        CAM_PATH_MOVE(SEARCH_ID("01cam_01"), SEARCH_ID("01cam_01_MOTION"));
        local37 = MODEL_PLAYER();
        WAIT(120);
        FADE_OUT(0, 30);
        WAIT(30);
        BIT_ON(1344);
        BIT_ON(1354);
        BIT_ON(2353);
        BIT_ON(1388);
        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        FADE_IN(0, 30);
        WAIT(30);
        BIT_OFF(1884);
        SET_ALLPANEL(3);
        PAD_ENABLE();
    }
    if (BIT_CHK(1353) == 0 && BIT_CHK(1383))
    {
        PAD_DISABLE();
        SET_ALLPANEL(2);
        FLD_BGM_FADE();
        FLD_BGM_PLAY(130);
        FADE_IN(0, 90);
        BIT_ON(1353);
        MODEL_POS(MODEL_PLAYER(), SEARCH_ID("01pos_15"));
        local38 = MODEL_DSP(6, 58);
        MODEL_POS(local38, SEARCH_ID("01pos_16"));
        FLD_MODEL_LIGHT(local38);
        CAM_SEL_FOVY(SEARCH_ID("01cam_05"));
        WAIT(90);
        itfMesMngOpenWindow();
        itfMesMngMessage(26) /* F023_DEVILENT_03: Ha! */;
        itfMesMngCloseWindow();
        CAM_SEL_FOVY(SEARCH_ID("01cam_06"));
        FLD_MSE_PLAY2(13, 0);
        MODEL_ROT(local38, SEARCH_ID("01pos_16"), 30);
        MODEL_WAIT(local38);
        MODEL_MOVE(local38, SEARCH_ID("01pos_17"), 0, 75, 8);
        MODEL_WAIT(local38);
        WAIT(15);
        MODEL_ROT(local38, SEARCH_ID("01pos_17"), 30);
        MODEL_WAIT(local38);
        itfMesMngOpenWindow();
        itfMesMngMessage(27) /* F023_DEVILENT_04: ...Oh, yeah. */;
        itfMesMngCloseWindow();
        MODEL_ROT(local38, SEARCH_ID("01pos_16"), 30);
        MODEL_WAIT(local38);
        FLD_MSE_PLAY2(13, 1);
        FLD_SE_PLAY(64);
        OBJ_PATH_MOVE(SEARCH_ID("md_01d_01"), SEARCH_ID("01path_01"), 0);
        OBJ_PATH_MOVE(SEARCH_ID("md_01d_01b"), SEARCH_ID("01path_02"), 0);
        WAIT(30);
        MODEL_MOVE(local38, SEARCH_ID("01pos_18"), 0, 75, 8);
        WAIT(15);
        FADE_OUT(0, 30);
        WAIT(30);
        FLD_SE_PLAY(64);
        OBJ_PATH_MOVE(SEARCH_ID("md_01d_01"), SEARCH_ID("01path_01"), 1);
        OBJ_PATH_MOVE(SEARCH_ID("md_01d_01b"), SEARCH_ID("01path_02"), 1);
        WAIT(30);
        FLD_BGM_FADE();
        FLD_BGM_PLAY(1);
        CALL_FIELD2(6, "01pos_15");
        return;
    }
}

void 006_01eve_01()
{
    while (1)
    {
        if (ACT_WIN_DSP(1))
        {
            PAD_DISABLE();
            SET_ALLPANEL(6);
            CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
            var0 = MODEL_PLAYER();
            MODEL_OFF(var0);
            MODEL_SHADOW_OFF(var0);
            itfMesMngOpenWindow();
            if (BIT_CHK(79))
            {
                itfMesMngMessage(25) /* F023_DEVIL_TARM_07: Our new leader is {firstname 3}! */;
            }
            else if (BIT_CHK(88))
            {
                itfMesMngMessage(24) /* F023_DEVIL_TARM_06: Our old headquarters' been bustling with activity lately. */;
            }
            else if (BIT_CHK(36))
            {
                itfMesMngMessage(23) /* F023_DEVIL_TARM_05: I hear Kabukicho's done for... */;
            }
            else if (BIT_CHK(38))
            {
                itfMesMngMessage(22) /* F023_DEVIL_TARM_04: ...I can't believe it. Gozu-Tennoh's... */;
            }
            else if (BIT_CHK(22))
            {
                itfMesMngMessage(21) /* F023_DEVIL_TARM_03: What the hell's happening? It's pretty damn loud over at our headquar... */;
            }
            else if (BIT_CHK(26) && BIT_CHK(263) == 1)
            {
                itfMesMngMessage(20) /* F023_DEVIL_DAISOUZYOU: The demon with the strong aura seems to have disappeared! */;
            }
            else if (BIT_CHK(26) && BIT_CHK(263) == 0)
            {
                itfMesMngMessage(19) /* F023_DEVIL_TARM_02: Everyone went to attack Nihilo. */;
            }
            else
            {
                if (BIT_CHK(1360))
                {
                    itfMesMngMessage(15) /* F023_DEVIL_TARM_01_YES02: Power is everything! */;
                }
                else if (BIT_CHK(1361))
                {
                    itfMesMngMessage(17) /* F023_DEVIL_TARM_01_NO02: Power is everything! */;
                }
                else
                {
                    itfMesMngMessage(12) /* F023_DEVIL_TARM_01: Power is everything! */;
                    local39 = itfMesMngSelect(13) /* F023_DEVIL_TARM_01_SEL: Absolutely. / Absolutely not. / No comment. */;
                    if (local39 == 0)
                    {
                        itfMesMngMessage(14) /* F023_DEVIL_TARM_01_YES: You know your shit, buddy!! */;
                        BIT_ON(1360);
                        POINT_ADD(1, 2);
                    }
                    else if (local39 == 1)
                    {
                        itfMesMngMessage(16) /* F023_DEVIL_TARM_01_NO: WHAT???? */;
                        BIT_ON(1361);
                        POINT_ADD(3, 2);
                    }
                    else
                    {
                        itfMesMngMessage(18) /* F023_DEVIL_TARM_01_HATEN: Make up your mind... */;
                    }
                }
            }
            itfMesMngCloseWindow();
            MODEL_ON(var0);
            MODEL_SHADOW_ON(var0);
            CAM_SEL_FOVY(- 1);
            SET_ALLPANEL(7);
            PAD_ENABLE();
            return;
        }
        SYNC();
    }
}

