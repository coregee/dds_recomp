void 002_01eve_01()
{
    if (BIT_CHK(1348) == 0 && BIT_CHK(38) == 0)
    {
        while (1)
        {
            if (ACT_WIN_DSP(1))
            {
                PAD_DISABLE();
                SET_ALLPANEL(6);
                FADE_OUT(0, 30);
                WAIT(30);
                MODEL_POS(MODEL_PLAYER(), SEARCH_ID("01pos_04"));
                CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
                FADE_IN(0, 30);
                WAIT(30);
                itfMesMngOpenWindow();
                if (BIT_CHK(1347))
                {
                    itfMesMngMessage(8) /* F023_DEVILENT_02: ...You again!? */;
                    if (itfMesMngSelect(9) /* F023_DEVILENT_SEL02: Yes. / No. */ == 0)
                    {
                        itfMesMngMessage(6) /* F023_DEVILENT_YES: Whoa! You've got some balls! */;
                        itfMesMngCloseWindow();
                        BIT_ON(1348);
                        FLD_ATARI_OFF(0, 0, "atari_hoji_01");
                        CALL_NEXT(1, 23, 500);
                        CALL_BATTLE(75);
                        return;
                    }
                    else
                    {
                        itfMesMngMessage(10) /* F023_DEVILENT_NO02: Then, get lost! */;
                    }
                }
                else
                {
                    BIT_ON(1347);
                    itfMesMngMessage(4) /* F023_DEVILENT: Hey, you! Yeah, you! ...I've never seen you before! */;
                    if (itfMesMngSelect(5) /* F023_DEVILENT_SEL01: Of course I did. / I didn't know. */ == 0)
                    {
                        itfMesMngMessage(6) /* F023_DEVILENT_YES: Whoa! You've got some balls! */;
                        itfMesMngCloseWindow();
                        BIT_ON(1348);
                        FLD_ATARI_OFF(0, 0, "atari_hoji_01");
                        CALL_NEXT(1, 23, 500);
                        CALL_BATTLE(75);
                        return;
                    }
                    else
                    {
                        itfMesMngMessage(7) /* F023_DEVILENT_NO: Then, get outta here! */;
                    }
                }
                itfMesMngCloseWindow();
                FADE_OUT(0, 30);
                WAIT(30);
                SET_ALLPANEL(7);
                PAD_ENABLE();
                SET_CHASE_CAMERA();
                CAM_SEL_FOVY(- 1);
                FADE_IN(0, 30);
                WAIT(30);
            }
            SYNC();
        }
    }
}

