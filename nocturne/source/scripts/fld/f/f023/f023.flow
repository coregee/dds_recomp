    if (BIT_CHK(22) == 0)
    {
        while (1)
        {
            if (ACT_WIN_DSP(1) == 1)
            {
                if (BIT_CHK(256) == 1)
                {
                    PAD_DISABLE();
                    SET_ALLPANEL(6);
                    var0 = MODEL_PLAYER();
                    MODEL_OFF(var0);
                    CAM_SEL(SEARCH_ID("01cam_07"));
                    CAM_PATH_MOVE(SEARCH_ID("01cam_07"), SEARCH_ID("01cam_07_MOTION"));
                    WAIT(30);
                    itfMesMngOpenWindow();
                    itfMesMngMessage(2) /* MANE_TUIKA01: Being a demon must be hard. */;
                    itfMesMngCloseWindow();
                }
                else if (BIT_CHK(1383) == 1)
                {
                    PAD_DISABLE();
                    SET_ALLPANEL(6);
                    var0 = MODEL_PLAYER();
                    MODEL_OFF(var0);
                    CAM_SEL(SEARCH_ID("01cam_07"));
                    CAM_PATH_MOVE(SEARCH_ID("01cam_07"), SEARCH_ID("01cam_07_MOTION"));
                    WAIT(30);
                    itfMesMngOpenWindow();
                    itfMesMngMessage(3) /* MANE_TUIKA02: It was a breach of the weapons prohibition. */;
                    itfMesMngCloseWindow();
                }
                else
                {
                    PAD_DISABLE();
                    SET_ALLPANEL(6);
                    CAM_SEL(SEARCH_ID("01cam_02"));
                    CAM_PATH_MOVE(SEARCH_ID("01cam_02"), SEARCH_ID("01cam_02_MOTION"));
                    WAIT(30);
                    itfMesMngOpenWindow();
                    itfMesMngMessage(0) /* MANE001_01: The tall building up ahead is the headquarters of the Mantra. */;
                    CAM_PATH_WAIT(SEARCH_ID("01cam_02"));
                    itfMesMngMessage(1) /* MANE001_02: You shouldn't go near it. */;
                    itfMesMngCloseWindow();
                }
                FADE_OUT(0, 30);
                WAIT(30);
                MODEL_ON(var0);
                CAM_SEL(- 1);
                FADE_IN(0, 30);
                WAIT(30);
                SET_ALLPANEL(7);
                PAD_ENABLE();
            }
            SYNC();
        }
    }
}

