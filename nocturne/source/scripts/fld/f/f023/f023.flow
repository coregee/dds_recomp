                itfMesMngMessage(20) /* F023_DEVIL_DAISOUZYOU */;
            }
            else if (BIT_CHK(26) && BIT_CHK(263) == 0)
            {
                itfMesMngMessage(19) /* F023_DEVIL_TARM_02 */;
            }
            else
            {
                if (BIT_CHK(1360))
                {
                    itfMesMngMessage(15) /* F023_DEVIL_TARM_01_YES02 */;
                }
                else if (BIT_CHK(1361))
                {
