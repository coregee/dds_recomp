}

void 017_start()
{
    PAD_DISABLE();
    local28 = MODEL_DSP(1, 86);
    if (BIT_CHK(88))
    {
        MODEL_CLS(local28);
        itfMesMngOpenWindow();
        itfMesMngMessage(35) /* F26_FUIN_NOMAN */;
        itfMesMngCloseWindow();
    }
    else
    {
        MODEL_POS(MODEL_PLAYER(), SEARCH_ID("01pos_04"));
        if ((BIT_CHK(84) && BIT_CHK(85) && BIT_CHK(86)) == 0)
        {
            MODEL_CLS(local28);
            itfMesMngOpenWindow();
            itfMesMngMessage(36) /* F26_FUIN_YOKI */;
            itfMesMngCloseWindow();
        }
        else
        {
            CAM_SEL(SEARCH_ID("01cam_01"));
            MODEL_POS(local28, SEARCH_ID("01pos_03"));
            itfMesMngOpenWindow();
            itfMesMngMessage(37) /* F26_ONGYO */;
            if (itfMesMngSelect(38))
            {
                itfMesMngMessage(39) /* F26_ONGYO_NO */;
                itfMesMngCloseWindow();
                FADE_OUT(0, 15);
                WAIT(15);
                SET_CHASE_CAMERA();
                CAM_SEL(- 1);
            }
            else
            {
                CAM_SEL(SEARCH_ID("01cam_03"));
                itfMesMngMessage(40) /* F26_ONGYO_YES */;
                CAM_SEL(SEARCH_ID("01cam_02"));
                itfMesMngMessage(41) /* F26_ONGYO_YES2 */;
                BIT_ON(88);
                CALL_BATTLE(386);
            }
        }
    }
    PAD_ENABLE();
}

void 017_01eve_03()
{
    if (BIT_CHK(88) == 0)
    {
        PAD_DISABLE();
        CALL_FIELD2(11, "01pos_07");
        PAD_ENABLE();
        return;
    }
}

