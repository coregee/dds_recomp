            itfMesMngMessage(29) /* F26_FUUKI_PAY */;
            if (itfMesMngSelect(30) == 0)
            {
                itfMesMngMessage(31) /* F26_FUUKI_PAY2 */;
                if (itfMesMngSelect(30) == 0)
                {
                    itfMesMngMessage(32) /* F26_FUUKI_PAY3 */;
                    if (itfMesMngSelect(30) == 0)
                    {
                        itfMesMngMessage(33) /* F26_FUUKI_PAY4 */;
                    }
                    else
                    {
                        itfMesMngMessage(34) /* F26_FUUKI_BATTLE */;
                        itfMesMngCloseWindow();
                        BIT_ON(84);
                        CALL_BATTLE(386);
                    }
                }
                else
                {
                    itfMesMngMessage(34) /* F26_FUUKI_BATTLE */;
                    itfMesMngCloseWindow();
                    BIT_ON(84);
                    CALL_BATTLE(386);
