void 015_01eve_01()
{
    while (1)
    {
        if (ACT_WIN_DSP3(5))
        {
            PAD_DISABLE();
            FADE_OUT(0, 10);
            WAIT(10);
            CAM_SEL_FOVY(SEARCH_ID("01cam_01"));
            var0 = MODEL_PLAYER();
            MODEL_POS(var0, SEARCH_ID("01pos_01"));
            WAIT(10);
            FADE_IN(0, 10);
            FLD_SE_PLAY(96);
            OBJ_PATH_MOVE(SEARCH_ID("01all_02"), SEARCH_ID("01path_02"), 0);
            WAIT(30);
            FADE_OUT(0, 30);
            WAIT(30);
            FLD_SE_STOP(96);
            CALL_FIELD2(12, "01pos_13");
            return;
        }
        SYNC();
    }
}

void 015_01eve_02()
{
    while (1)
    {
        if (ACT_WIN_DSP3(9))
        {
            PAD_DISABLE();
            itfMesMngOpenWindow();
            itfMesMngMessage(48) /* f031_GO_KAGUTUTI: > Will you go to the Tower of Kagutsuchi? */;
            if (itfMesMngSelect(49) /* f031_GO_KAG_SEL: Yes. / No. */ == 0)
            {
                itfMesMngCloseWindow();
                FLD_SE_PLAY(101);
                FADE_OUT(1, 30);
                WAIT(30);
                if (BIT_CHK(1632) == 0)
                {
                    FLD_SE_STOP(101);
                    FLD_BGM_FADE();
                    CALL_NEXT(1, 32, 704);
                    CALL_EVENT(704);
                    return;
                }
                else
                {
                    FLD_GIMIC_HOJI(32, 1, 1, 0);
                    FLD_GIMIC_HOJI(32, 1, 2, 0);
                    FLD_GIMIC_HOJI(32, 1, 3, 0);
                    FLD_GIMIC_HOJI(32, 1, 4, 0);
                    FLD_GIMIC_HOJI(32, 2, 1, 0);
                    FLD_GIMIC_HOJI(32, 5, 1, 0);
                    FLD_GIMIC_HOJI(32, 8, 1, 0);
                    FLD_GIMIC_HOJI(32, 11, 1, 0);
                    FLD_SE_STOP(101);
                    FLD_CALL_WAPEX(35);
                    return;
                }
            }
            itfMesMngCloseWindow();
            PAD_ENABLE();
        }
        SYNC();
    }
}

