                    FLD_KANKYO(14, 1);
                    OBJ_PATH_MOVE(SEARCH_ID("atari_hoji_04"), SEARCH_ID("path_hoji_04"), 1);
                    OBJ_PATH_MOVE(SEARCH_ID("atari_hoji_05"), SEARCH_ID("path_hoji_05"), 1);
                    OBJ_PATH_WAIT(SEARCH_ID("atari_hoji_04"));
                    OBJ_PATH_WAIT(SEARCH_ID("atari_hoji_05"));
                    FLD_MODEL_OFF(0, 0, "md_hoji_02", 1);
                    FLD_MODEL_ON(0, 0, "md_hoji_03", 1);
                    FLD_ATARI_OFF(0, 0, "atari_hoji_03");
                    SET_CHASE_CAMERA();
                    CAM_SEL(- 1);
                    BIT_OFF(1614);
                    ENCOUNT_ON();
                    MOON_START();
                }
                else
                {
                    itfMesMngCloseWindow();
                    var0 = MODEL_PLAYER();
                    MODEL_MOTION2(var0, 4, 3, 15, 1);
                    MODEL_MOVE(var0, SEARCH_ID("01pos_35"), 0, 75, 100);
                    MODEL_WAIT(var0);
                }
                PAD_ENABLE();
            }
        }
        SYNC();
    }
}

