void 003_01eve_01()
{
    while (1)
    {
        if (ACT_WIN_DSP3(9) == 1)
        {
            PAD_DISABLE();
            FLD_MAP_ON(0, 0, 20);
            itfMesMngOpenWindow();
            var0 = MODEL_PLAYER();
            CAM_SEL_FOVY(SEARCH_ID("01cam_10"));
            MODEL_POS(var0, SEARCH_ID("01pos_02"));
            if (BIT_CHK(1614))
            {
                itfMesMngMessage(3) /* REVERSE_AIR: > Will you revert the effects? */;
            }
            else
            {
                itfMesMngMessage(0) /* GIMMICK_TOUCH: > There is a glowing sphere... */;
            }
            if (itfMesMngSelect(1) /* GIMMICK_TOUCH_SEL: Yes. / No. */)
            {
                itfMesMngCloseWindow();
                MODEL_POS(var0, SEARCH_ID("01pos_14"));
                if (BIT_CHK(1614))
                {
                    SET_FIX_CAMERA(SEARCH_ID("01cam_01"));
                }
                else
                {
                    SET_CHASE_CAMERA();
                }
                CAM_SEL(- 1);
                PAD_ENABLE();
                return;
            }
            itfMesMngCloseWindow();
            MODEL_POS(var0, SEARCH_ID("01pos_14"));
            SET_CHASE_CAMERA();
            CAM_SEL(- 1);
            MODEL_MOTION2(var0, 16, 4, 20, 0);
            MODEL_WAIT(var0);
            if (BIT_CHK(1614) == 0)
            {
                BIT_ON(1614);
                ENCOUNT_OFF();
                MOON_STOP();
                FLD_SE_PLAY(98);
                FLD_BGM_FADE();
                FLD_BGM_PLAY(2);
                FLD_KANKYO(7, 1);
                FLD_MODEL_ON(0, 0, "md_hoji_02", 1);
                FLD_MODEL_ON(0, 0, "md_hoji_06", 1);
                FLD_ATARI_ON(0, 0, "atari_hoji_03");
                SET_FIX_CAMERA(SEARCH_ID("01cam_01"));
                WAIT(30);
                itfMesMngOpenWindow();
                itfMesMngMessage(2) /* CHANGE_AIR: > The atmosphere around you changed. */;
                itfMesMngCloseWindow();
                CHG_MOON(0);
                var249 = 0;
                WAIT(30);
            }
            else
            {
                BIT_OFF(1614);
                ENCOUNT_ON();
                MOON_START();
                FLD_SE_PLAY(98);
                FLD_BGM_FADE();
                FLD_BGM_PLAY(1);
                FLD_KANKYO(3, 1);
                FLD_MODEL_OFF(0, 0, "md_hoji_02", 1);
                FLD_MODEL_ON(0, 0, "md_hoji_06", 1);
                FLD_ATARI_OFF(0, 0, "atari_hoji_03");
                WAIT(30);
                SET_CHASE_CAMERA();
                CAM_SEL(- 1);
            }
            OBJ_PATH_MOVE(SEARCH_ID("atari_hoji_04"), SEARCH_ID("path_hoji_04"), 1);
            PAD_ENABLE();
        }
        SYNC();
    }
}

