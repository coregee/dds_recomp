void 027_01npc_01()
{
    while (1)
    {
        if (ACT_WIN_DSP(1))
        {
            PAD_DISABLE();
            SET_ALLPANEL(6);
            itfMesMngOpenWindow();
            if (BIT_CHK(1391))
            {
                itfMesMngMessage(134) /* F024_027_DEVIL01_YES04: Only the select few deserve to live. */;
            }
            else if (BIT_CHK(1390))
            {
                itfMesMngMessage(137) /* F024_027_DEVIL02: Only the select few deserve to live. */;
            }
            else
            {
                itfMesMngMessage(129) /* F024_027_DEVIL01: Only the select few deserve to live. Don't you agree? */;
                local56 = itfMesMngSelect(130) /* F024_027_DEVIL_SEL: Of course. / Of course not. / No comment. */;
                if (local56 == 0)
                {
                    itfMesMngMessage(131) /* F024_027_DEVIL01_YES01: I like your attitude. You can have this. */;
                    itfMesMngMessage(132) /* F024_027_DEVIL01_YES02: > You obtained 1000 Macca. */;
                    itfMesMngMessage(133) /* F024_027_DEVIL01_YES03: Do not stray away from your belief... */;
                    COMM_139(1000);
                    POINT_ADD(1, 2);
                    BIT_ON(1391);
                }
                else if (local56 == 1)
                {
                    itfMesMngMessage(135) /* F024_027_DEVIL01_NO: ...Hmph, what a bore. */;
                    POINT_ADD(3, 2);
                    BIT_ON(1390);
                }
                else
                {
                    itfMesMngMessage(136) /* F024_027_DEVIL01_HATENA: I just wanted to test you. Please don't get angry... */;
                    POINT_ADD(2, 1);
                    BIT_ON(1390);
                }
            }
            itfMesMngCloseWindow();
            SET_ALLPANEL(7);
            PAD_ENABLE();
        }
        SYNC();
    }
}

