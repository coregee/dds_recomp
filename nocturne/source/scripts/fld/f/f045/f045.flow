void 011_01eve_01()
{
    while (1)
    {
        if (ACT_WIN_DSP2(9) == 1)
        {
            PAD_DISABLE();
            var0 = MODEL_PLAYER();
            MODEL_OFF(var0);
            MODEL_SHADOW_OFF(var0);
            CAM_SEL(SEARCH_ID("01cam_01"));
            itfMesMngOpenWindow();
            var250 = prm_BOSS_PRESS_REC(970, 0);
            var251 = prm_BOSS_PRESS_REC(970, 2);
            itfMesMngSetVarScr(0, var250, 0);
            if (BIT_CHK(2019))
            {
                if (var250 <= var251)
                {
                    itfMesMngMessage(24) /* MITO_BEST_SCORE_R: > "Record of Mithra: Defeated in {var 0} turn(s)." */;
                }
                else
                {
                    itfMesMngMessage(23) /* MITO_BEST_SCORE: > "Record of Mithra: Defeated in {var 0} turn(s)." */;
                }
            }
            else
            {
                if (BIT_CHK(1681) == 0)
                {
                    itfMesMngMessage(19) /* NO_NAME: > There is a tombstone without a name on it... */;
                    itfMesMngCloseWindow();
                    FADE_OUT(0, 15);
                    WAIT(15);
                    MODEL_ON(var0);
                    MODEL_SHADOW_ON(var0);
                    CAM_SEL(- 1);
                    FADE_IN(0, 15);
                    WAIT(15);
                    PAD_ENABLE();
                    return;
                }
                if (prm_BOSS_PRESS_REC(970, 0) < 999)
                {
                    if (var250 <= var251)
                    {
                        itfMesMngMessage(24) /* MITO_BEST_SCORE_R: > "Record of Mithra: Defeated in {var 0} turn(s)." */;
                    }
                    else
                    {
                        itfMesMngMessage(23) /* MITO_BEST_SCORE: > "Record of Mithra: Defeated in {var 0} turn(s)." */;
                    }
                }
                else
                {
                    itfMesMngMessage(25) /* MITO_BOHI: > It is inscribed, "Here lies Mithra." */;
                }
                if (BIT_CHK(1006) == 0)
                {
                    itfMesMngCloseWindow();
                    FADE_OUT(0, 15);
                    WAIT(15);
                    MODEL_ON(var0);
                    MODEL_SHADOW_ON(var0);
                    CAM_SEL(- 1);
                    FADE_IN(0, 15);
                    WAIT(15);
                    PAD_ENABLE();
                    return;
                }
            }
            BIT_ON(2598);
            itfMesMngMessage(20) /* VISER_USE: > Will you put on the Black Visor? */;
            if (itfMesMngSelect(0) /* YN_SEL: Yes. / No. */)
            {
                itfMesMngCloseWindow();
                FADE_OUT(0, 15);
                WAIT(15);
                MODEL_ON(var0);
                MODEL_SHADOW_ON(var0);
                CAM_SEL(- 1);
                FADE_IN(0, 15);
                WAIT(15);
                PAD_ENABLE();
                return;
            }
            itfMesMngMessage(26) /* MITO_REMEMBER: > You recall the battle against Mithra... */;
            itfMesMngCloseWindow();
            FADE_OUT(1, 30);
            WAIT(30);
            CALL_NEXT(1, 45, 500);
            CALL_BATTLE(970);
            return;
        }
        SYNC();
    }
}

