void 017_pixy()
{
    if (BIT_CHK(2029) == 0)
    {
        PAD_DISABLE();
        SET_ALLPANEL(0);
        FLD_BGM_FADE();
        FLD_BGM_PLAY(134);
        local79 = prm_PIKUKO_GETID();
        local80 = MODEL_DSP(6, local79);
        FLD_MODEL_LIGHT(local80);
        MODEL_POS(local80, SEARCH_ID("01pos_12"));
        CAM_SEL_FOVY(SEARCH_ID("01cam_03"));
        itfMesMngSetVarScr(0, local79, 1);
        itfMesMngOpenWindow();
        itfMesMngMessage(77) /* PIXY_REBIRTH_SYSTEM_01: > {var 0} is acting strangely... */;
        itfMesMngCloseWindow();
        FADE_OUT(0, 10);
        WAIT(10);
        CAM_SEL_FOVY(SEARCH_ID("01cam_04"));
        FADE_IN(0, 10);
        WAIT(10);
        QUAKE_ON(0, 50);
        itfMesMngOpenWindow();
        itfMesMngMessage(78) /* PIXY_REBIRTH_01: What's happening...? I feel this... power... growing inside me... */;
        itfMesMngCloseWindow();
        FADE_OUT(1, 5);
        WAIT(5);
        FADE_IN(1, 5);
        WAIT(10);
        FADE_OUT(1, 10);
        WAIT(10);
        FADE_IN(1, 10);
        WAIT(20);
        FADE_OUT(1, 20);
        WAIT(20);
        QUAKE_OFF();
        MODEL_CLS(local80);
        local81 = EFFBED_LOAD("/fld/f/bin/DEVILGEN.BED");
        local80 = MODEL_DSP(6, 61);
        FLD_MODEL_LIGHT(local80);
        FADE_IN(1, 20);
        WAIT(60);
        COMM_217(1);
        EFFECT_POS(local81, SEARCH_ID("01pos_12"));
        EFFBED_START(local81, 0);
        WAIT(10);
        MODEL_A(local80, 0, 0.0f);
        MODEL_POS(local80, SEARCH_ID("01pos_12"));
        MODEL_A(local80, 15, 1.0f);
        QUAKE_ON(10, 300);
        PAD_ACT(1, 170, 10);
        PAD_ACT(0, 1, 10);
        WAIT(10);
        WAIT(60);
        FADE_OUT(0, 10);
        WAIT(10);
        CAM_SEL_FOVY(SEARCH_ID("01cam_05"));
        FADE_IN(0, 10);
        WAIT(10);
        itfMesMngOpenWindow();
        itfMesMngMessage(79) /* PIXY_REBIRTH_02: What? Why are you looking at me like that? */;
        itfMesMngCloseWindow();
        FADE_OUT(0, 10);
        WAIT(10);
        MODEL_POS(local80, SEARCH_ID("01pos_13"));
        CAM_SEL_FOVY(SEARCH_ID("01cam_03"));
        FADE_IN(0, 10);
        WAIT(10);
        itfMesMngOpenWindow();
        itfMesMngMessage(80) /* PIXY_REBIRTH_03: Um, you're not waiting for me to say my line, are you...? *sigh* Alri... */;
        itfMesMngCloseWindow();
        COMM_217(5);
        MODEL_MOTION2(local80, 14, 3, 15, 0);
        MODEL_WAIT_MOT(local80, 0);
        WAIT(75);
        FLD_BGM_FADE();
        FLD_BGM_PLAY(1);
        FLD_ANAHORI_DEL();
        prm_DV_PLUS(61, 2, 0);
        prm_DV_COPY_PARAM(61, 215);
        FADE_OUT(0, 15);
        WAIT(15);
        MODEL_CLS(local80);
        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        FADE_IN(0, 15);
        WAIT(15);
        BIT_ON(2029);
        SET_ALLPANEL(3);
        PAD_ENABLE();
    }
}

