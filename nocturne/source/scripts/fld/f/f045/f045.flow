void 021_exit_door()
{
    PAD_DISABLE();
    SET_ALLPANEL(0);
    itfMesMngOpenWindow();
    itfMesMngOpenWindow();
    if (BIT_CHK(2028))
    {
        itfMesMngMessage(85) /* KAISU_DOOR_OUT: We have warned you, foolish demon! */;
        itfMesMngCloseWindow();
        FADE_OUT(1, 30);
        FLD_SE_PLAY(56);
        WAIT(30);
        BIT_OFF(2026);
        BIT_OFF(2027);
        BIT_OFF(2028);
        FLD_CALL_WAPEX(155);
        return;
    }
    else if (BIT_CHK(2027))
    {
        BIT_ON(2028);
        itfMesMngMessage(84) /* KAISU_DOOR_3RD: Attention trespassers... */;
    }
    else if (BIT_CHK(2026))
    {
        BIT_ON(2027);
        itfMesMngMessage(83) /* KAISU_DOOR_2ND: Attention trespassers... */;
    }
    else
    {
        BIT_ON(2026);
        itfMesMngMessage(82) /* KAISU_DOOR_1ST: Attention trespassers... */;
    }
    itfMesMngCloseWindow();
    SET_ALLPANEL(3);
    PAD_ENABLE();
}

