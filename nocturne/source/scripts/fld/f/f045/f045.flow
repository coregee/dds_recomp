    itfMesMngOpenWindow();
    itfMesMngMessage(98) /* F045_AREA29_IZA001: You have come at last, {name 0}. */;
    CAM_SEL_FOVY(SEARCH_ID("01cam_03"));
    itfMesMngMessage(99) /* F045_AREA29_IZA002: Izanami and I had long watched over the land of the rising sun. */;
    CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
    itfMesMngMessage(100) /* F045_AREA29_IZA003: Unable to wield our strength, */;
    CAM_SEL_FOVY(SEARCH_ID("01cam_01"));
    var0 = MODEL_PLAYER();
    MODEL_POS(var0, SEARCH_ID("01pos_04"));
    itfMesMngMessage(101) /* F045_AREA29_IZA003_02: ...And now you have come. */;
    itfMesMngMessage(102) /* F045_AREA29_IZA004: {name 0}, please accept our gift. */;
    itfMesMngCloseWindow();
    COMM_217(86);
    DIST_BLUR_OFF(0);
    BLUR2_PARA(0.02f, 1.136f, 1);
    BLUR2_RGBA(128, 128, 128, 86);
    BLUR2_AREA(0, 0);
    BLUR2_ON(20);
    WAIT(18);
    PAD_ACT(1, 250, 8);
    WAIT(2);
    FADE_IN(1, 10);
    WAIT(10);
    CAM_SEL_FOVY(SEARCH_ID("01cam_04"));
    FADE_IN(1, 10);
    WAIT(2);
    PAD_ACT(1, 250, 8);
    WAIT(8);
    BLUR2_OFF(20);
    DIST_BLUR_ON(0);
    itfMesMngOpenWindow();
    itfMesMngMessage(103) /* F045_AREA29_IZA005: > Your body surges with power... */;
    itfMesMngMessage(104) /* F045_AREA29_IZA005_002: > You are now able to attack more often. */;
    CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
    itfMesMngMessage(105) /* F045_AREA29_IZA006: Farewell, {name 0}. */;
    BIT_ON(2240);
    CAM_SEL_FOVY(SEARCH_ID("01cam_01"));
    itfMesMngMessage(106) /* F045_AREA29_IZA007: May the heavens bless you... */;
    itfMesMngCloseWindow();
    WAIT(30);
    DIST_BLUR_OFF(0);
    DIST_BLUR_PARA(60, 175, 2, 0.1f, 0.0f, 0.13f, 0);
    DIST_BLUR_RGBA(132, 132, 132, 101);
    DIST_BLUR_AREA(256, 0, 0);
    DIST_BLUR_ON(1);
    WAIT(30);
    FLD_SE_PLAY(56);
    FADE_OUT(1, 30);
    WAIT(30);
    DIST_BLUR_OFF(0);
    FLD_CALL_WAPEX(172);
    return;
}

