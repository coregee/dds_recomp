void 022_01npc_01()
{
    while (1)
    {
        if (ACT_WIN_DSP(1))
        {
            PAD_DISABLE();
            SET_NPC_CAMERA("01npc_01");
            SET_ALLPANEL(6);
            FLD_BGM_FADE();
            FLD_BGM_PLAY(136);
            local83 = prm_PLAYER_GET_LEVEL();
            if (local83 > 57)
            {
                WAIT(1);
                if (BIT_CHK(313) == 0)
                {
                    WAIT(1);
                    if (prm_STOCK_FULL_CHECK() == 0)
                    {
                        local84 = 200000;
                        itfMesMngOpenWindow();
                        itfMesMngMessage(183) /* F041_SINEN_LEV001: ...You're pretty strong. */;
                        if (prm_DV_CHECK(105) == 0)
                        {
                            itfMesMngMessage(186) /* F041_SINEN_LEV003: Here's what I'm selling... */;
                            if (itfMesMngSelect(187) /* F041_SINEN_LEV003_SEL: Alright, I'll buy it. / No thanks. */ == 0)
                            {
                                local84 = 200000;
                                if (prm_MAKA_CHECK(local84) == 0)
                                {
                                    itfMesMngMessage(193) /* F041_SINEN_KANE: Hey, you don't have enough Macca! */;
                                    itfMesMngCloseWindow();
                                    goto END;
                                }
                                else
                                {
                                    itfMesMngMessage(188) /* F041_SINEN_LEV004: Excellent choice! */;
                                    itfMesMngMessage(189) /* F041_SINEN_LEV005: > You purchased a demon from the Shady Broker. */;
                                    itfMesMngCloseWindow();
                                    prm_DV_PLUS(105, 2, 0);
                                    prm_DV_COPY_PARAM(105, 213);
                                    BIT_ON(313);
                                    COMM_139(-local84);
                                    goto END;
                                }
                                WAIT(1);
                            }
                            itfMesMngMessage(192) /* F041_SINEN_LEVIRANAI: That's fine. If you change your mind, feel free to come back anytime. */;
                            itfMesMngCloseWindow();
                            goto END;
                            WAIT(1);
                        }
                        WAIT(1);
                        itfMesMngOpenWindow();
                        itfMesMngMessage(184) /* F041_SINEN_DAM: ...On second thought, forget what I just said. */;
                        itfMesMngCloseWindow();
                        goto END;
                    }
                    itfMesMngOpenWindow();
                    itfMesMngMessage(185) /* F041_SINEN_LEV002: ...You're pretty strong. */;
                    itfMesMngCloseWindow();
                    goto END;
                }
                WAIT(1);
            }
            if (BIT_CHK(313) == 0)
            {
                itfMesMngOpenWindow();
                itfMesMngMessage(181) /* F041_SINEN_X: ...I'm glad you made it here. */;
                itfMesMngCloseWindow();
            }
            else
            {
                itfMesMngOpenWindow();
                itfMesMngMessage(182) /* F041_SINEN_X2: ...I've got nothing else to sell you. ...Hey, don't worry. */;
                itfMesMngCloseWindow();
            }
        END:
            FLD_BGM_FADE();
            FLD_BGM_PLAY(1);
            SET_ALLPANEL(7);
            SET_CHASE_CAMERA();
            PAD_ENABLE();
        }
        SYNC();
    }
}

void 029start()
