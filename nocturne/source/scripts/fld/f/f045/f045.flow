    itfMesMngMessage(112) /* F045_AREA30_ROSINSI05: ...So, you made it... */;
    itfMesMngCloseWindow();
    CAM_SEL_FOVY(SEARCH_ID("01cam_04"));
    MODEL_POS(local94, SEARCH_ID("01pos_07"));
    WAIT(30);
    itfMesMngOpenWindow();
    itfMesMngMessage(113) /* F045_AREA30_ROSINSI06: ...Your strength... is outstanding... */;
    itfMesMngCloseWindow();
    CAM_SEL_FOVY(SEARCH_ID("01cam_05"));
    MODEL_POS(local94, SEARCH_ID("01pos_04"));
    CAM_PATH_MOVE(SEARCH_ID("01cam_05"), SEARCH_ID("01cam_05_MOTION"));
    itfMesMngOpenWindow();
    itfMesMngMessage(114) /* F045_AREA30_ROSINSI07: ...We shall meet again... soon... */;
    itfMesMngCloseWindow();
    WAIT(30);
    MODEL_MOTION2(local94, 2, 10, 10, 2);
    MODEL_WAIT(local94);
    DIST_BLUR_PARA(60, 175, 2, 0.1f, 0.0f, 0.13f, 0);
    DIST_BLUR_RGBA(132, 132, 132, 101);
    DIST_BLUR_AREA(256, 0, 0);
    DIST_BLUR_ON(1);
    WAIT(30);
    FLD_SE_PLAY(56);
    FADE_OUT(1, 30);
    WAIT(30);
    DIST_BLUR_OFF(0);
    BIT_ON(1088);
    FLD_CALL_WAPEX(171);
    return;
}

void 028_lets_go()
{
    PAD_DISABLE();
    SET_ALLPANEL(0);
    WAIT(30);
    DIST_BLUR_OFF(30);
    WAIT(30);
    itfMesMngOpenWindow();
    itfMesMngMessage(117) /* F045_AREA28_KERU_LETSGO: GO ON... THEY ARE WAITING FOR YOU. */;
    itfMesMngCloseWindow();
    SET_ALLPANEL(3);
    PAD_ENABLE();
}

