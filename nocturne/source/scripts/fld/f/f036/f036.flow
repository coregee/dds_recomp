                    BLUR2_AREA(0, 0);
                    BLUR2_ON(20);
                    WAIT(10);
                    COMM_217(86);
                    WAIT(10);
                    PAD_ACT(1, 250, 8);
                    WAIT(2);
                    FADE_IN(1, 10);
                    WAIT(8);
                    FADE_IN(1, 10);
                    WAIT(2);
                    PAD_ACT(1, 250, 8);
                    BLUR2_OFF(20);
                    WAIT(20);
                    itfMesMngMessage(10) /* AREA20_NPC_02 */;
                    BIT_ON(2038);
                }
                else
                {
                    itfMesMngMessage(11) /* AREA20_NPC_03 */;
                }
                itfMesMngCloseWindow();
                FADE_OUT(1, 30);
                WAIT(30);
                MODEL_CLS(var10);
                FADE_IN(1, 30);
                WAIT(30);
                itfMesMngOpenWindow();
                itfMesMngMessage(12) /* AREA20_NPC_04 */;
                itfMesMngCloseWindow();
                FLD_ATARI_OFF(0, 0, "atari_hoji_01");
                BIT_ON(2040);
                CAM_SEL(- 1);
                MODEL_ON(var0);
                SET_ALLPANEL(7);
                PAD_ENABLE();
                return;
            }
            SYNC();
        }
    }
}

