    CAM_PATH_MOVE(SEARCH_ID("01cam_02"), SEARCH_ID("01cam_02_MOTION"));
    MODEL_POS(local49, SEARCH_ID("01pos_03"));
    FLD_MODEL_LIGHT(local49);
    FADE_IN(1, 30);
    WAIT(60);
    itfMesMngOpenWindow();
    itfMesMngMessage(29) /* BOSS11 */;
    itfMesMngCloseWindow();
    FADE_OUT(0, 30);
    WAIT(30);
    FLD_CALL_WAPEX(42);
    return;
}

