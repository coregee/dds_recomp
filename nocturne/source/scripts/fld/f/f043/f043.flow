void 006_start()
{
    if (BIT_CHK(2345) == 1)
    {
        goto NAKA;
    }
    if (BIT_CHK(1435) == 1 && BIT_CHK(261) == 1)
    {
        PAD_DISABLE();
        SET_ALLPANEL(0);
        CAM_SEL(SEARCH_ID("01cam_04"));
        CAM_PATH_MOVE(SEARCH_ID("01cam_04"), SEARCH_ID("01cam_04_MOTION"));
        var0 = MODEL_PLAYER();
        MODEL_POS(var0, SEARCH_ID("01pos_09"));
        local72 = MODEL_DSP(6, 303);
        MODEL_POS(local72, SEARCH_ID("01pos_10"));
        MODEL_A(local72, 0, 0.0f);
        MODEL_OFF(local72);
        FLD_BGM_FADE();
        FLD_BGM_PLAY(128);
        FADE_IN(1, 5);
        WAIT(5);
        itfMesMngOpenWindow();
        itfMesMngMessage(107) /* FROST_001 */;
        itfMesMngCloseWindow();
        WAIT(15);
        itfMesMngOpenWindow();
        itfMesMngMessage(108) /* FROST_002 */;
        itfMesMngMessage(109) /* FROST_003 */;
        itfMesMngCloseWindow();
        WAIT(15);
        FLD_BGM_STOP();
        WAIT(1);
        FLD_BGM_PLAY(130);
        COMM_217(84);
        CAM_SEL(SEARCH_ID("01cam_03"));
        CAM_PATH_MOVE(SEARCH_ID("01cam_03"), SEARCH_ID("01cam_03_MOTION"));
        WAIT(5);
        QUAKE_ON(0, 160);
        local74 = EFFBED_LOAD("/fld/f/bin/DEVILGEN.BED");
        EFFBED_START(local74, 0);
        EFFECT_POS(local74, SEARCH_ID("01pos_10"));
        MODEL_ON(local72);
        MODEL_A(local72, 10, 1.0f);
        MODEL_MOTION2(local72, 4, 0, 0, 2);
        WAIT(50);
        MODEL_MOTION2(local72, 0, 20, 20, 0);
        QUAKE_OFF();
        itfMesMngOpenWindow();
        itfMesMngMessage(110) /* FROST_004 */;
        itfMesMngMessage(111) /* FROST_005 */;
        itfMesMngCloseWindow();
        WAIT(30);
        if (prm_DV_CHECK(206) == 0)
        {
            itfMesMngOpenWindow();
            itfMesMngMessage(112) /* FROST_006 */;
            itfMesMngCloseWindow();
            FADE_OUT(1, 5);
            WAIT(5);
            if (prm_STOCK_FULL_CHECK() == 1)
            {
                FADE_IN(1, 5);
                WAIT(5);
                itfMesMngOpenWindow();
                itfMesMngMessage(116) /* FROST_008 */;
                itfMesMngMessage(117) /* FROST_009 */;
                itfMesMngCloseWindow();
                FADE_OUT(1, 3);
                WAIT(3);
                MODEL_OFF(local72);
                FADE_IN(1, 3);
                WAIT(3);
                itfMesMngOpenWindow();
                itfMesMngMessage(118) /* FROST_010 */;
                itfMesMngCloseWindow();
                BIT_ON(2345);
            }
            else
            {
                prm_DV_PLUS(206, 1, 0);
                BIT_ON(305);
                MODEL_OFF(local72);
                FADE_IN(1, 5);
                WAIT(5);
                itfMesMngOpenWindow();
                itfMesMngMessage(114) /* FROST_007 */;
                itfMesMngCloseWindow();
                BIT_ON(2345);
            }
        }
        else
        {
            itfMesMngOpenWindow();
            itfMesMngMessage(113) /* FROST_IRU */;
            itfMesMngCloseWindow();
            BIT_ON(305);
            MODEL_OFF(local72);
            FADE_IN(1, 5);
            WAIT(5);
            itfMesMngOpenWindow();
            itfMesMngMessage(115) /* FROST_IRU002 */;
            itfMesMngCloseWindow();
            BIT_ON(2345);
        }
        FLD_BGM_FADE();
        FLD_BGM_RELOAD();
        FLD_BGM_RELOAD_WAIT();
        FLD_BGM_PLAY(1);
        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        SET_ALLPANEL(3);
        PAD_ENABLE();
        FADE_IN(0, 30);
        WAIT(30);
    NAKA:
    }
}

