        CAM_PATH_WAIT(SEARCH_ID("01cam_03"));
        WAIT(15);
        FADE_OUT(0, 15);
        WAIT(15);
        CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
        FADE_IN(0, 15);
        WAIT(15);
        itfMesMngOpenWindow();
        itfMesMngMessage(109) /* F025_TABIDACHI */;
        CAM_SEL_FOVY(SEARCH_ID("01cam_05"));
        itfMesMngMessage(110) /* F025_TABIDACHI02 */;
        MODEL_MOTION2(local52, 7, 10, 10, 0);
