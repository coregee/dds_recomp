        itfMesMngMessage(112) /* F025_TABIDACHI04 */;
        itfMesMngCloseWindow();
        FLD_MODEL_OFF(0, 2, "md_hoji_02", 0);
        FLD_ATARI_OFF(0, 2, "atari_hoji_02");
        FLD_MODEL_OFF(0, 3, "md_hoji_02", 0);
