    DIST_BLUR_PARA(35, 265, 50, 0.08f, 0.025f, 0.04f, 0);
    DIST_BLUR_RGBA(145, 145, 145, 50);
    DIST_BLUR_AREA(256, 0, 0);
    DIST_BLUR_ON(15);
    WAIT(170);
    if (BIT_CHK(1415) == 0)
    {
        FADE_OUT(1, 1);
        WAIT(1);
        FADE_IN(1, 1);
        WAIT(1);
        FADE_OUT(1, 1);
        WAIT(1);
        DIST_BLUR_OFF(0);
        CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
