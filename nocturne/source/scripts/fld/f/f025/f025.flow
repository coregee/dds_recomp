void 001_01eve_01()
{
    while (1)
    {
        if (ACT_WIN_DSP(9) == 1)
        {
            PAD_DISABLE();
            itfMesMngOpenWindow();
            SET_ALLPANEL(6);
            if (BIT_CHK(1429))
            {
                itfMesMngMessage(7) /* HAMAGURI_DENAI */;
            }
            else if (BIT_CHK(1414) == 0)
            {
                itfMesMngMessage(1) /* KANSHU6 */;
            }
            else
            {
                itfMesMngMessage(2) /* HAMAGURI */;
                local36 = itfMesMngSelect(3);
                if (local36 == 0)
                {
                    itfMesMngMessage(4) /* HAMAGURI_YES */;
                    local37 = MODEL_PLAYER();
                    MODEL_MOTION2(local37, 16, 10, 10, 3);
                    MODEL_WAIT(local37);
                    itfMesMngMessage(5) /* HAMAGURI_HASSEI */;
                    FLD_MODEL_ON2(0, 0, 1);
                    FLD_SE_PLAY(99);
                    WAIT(60);
                    if (BIT_CHK(1415) == 0)
                    {
                        WAIT(60);
                        FADE_OUT(1, 1);
                        WAIT(1);
                        FADE_IN(1, 1);
                        WAIT(1);
                        FADE_OUT(1, 1);
                        WAIT(1);
                        FLD_MODEL_ON2(0, 17, 1);
                        CALL_FIELD2(6, "01pos_01");
                        return;
                    }
                    else
                    {
                        FADE_OUT(1, 30);
                        WAIT(30);
                        FLD_MODEL_ON2(0, 17, 1);
                        FLD_CALL_WAPEX(9);
                        return;
                    }
                    return;
                }
                else
                {
                    itfMesMngMessage(6) /* HAMAGURI_NO */;
                }
            }
            SET_ALLPANEL(7);
            itfMesMngCloseWindow();
            PAD_ENABLE();
            return;
        }
        SYNC();
    }
}

