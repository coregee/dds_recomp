        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        FADE_IN(0, 15);
        WAIT(15);
        FLD_BGM_FADE();
        FLD_BGM_PLAY(1);
        BIT_ON(1435);
        SET_ALLPANEL(3);
        PAD_ENABLE();
    }
    if (BIT_CHK(1410) == 1)
    {
        if (BIT_CHK(36) == 0)
        {
            BIT_ON(36);
            BIT_OFF(1389);
            PAD_DISABLE();
            SET_ALLPANEL(2);
            FLD_BGM_FADE();
            FLD_BGM_PLAY(129);
            MODEL_POS(MODEL_PLAYER(), SEARCH_ID("01pos_14"));
            SET_CHASE_CAMERA();
            CAM_SEL_FOVY(- 1);
            CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
            local63 = MODEL_DSP(3, 16);
            WAIT(60);
            FLD_SE_PLAY(66);
            OBJ_PATH_MOVE(SEARCH_ID("md_01d_04"), SEARCH_ID("01path_01"), 0);
            WAIT(30);
            CAM_PATH_MOVE(SEARCH_ID("01cam_02"), SEARCH_ID("01cam_02_MOTION"));
            MODEL_POS(local63, SEARCH_ID("01pos_08"));
            FLD_MODEL_LIGHT(local63);
            MODEL_EXMOTION(local63, 3, 0, 0, 0, 1);
            KUTISET(local63, 1, 0);
            WAIT(30);
            MODEL_WAIT_MOT(local63, 1);
            MODEL_MOTION2(local63, 0, 0, 0, 0);
            WAIT(35);
            FLD_SE_PLAY(100);
            WAIT(15);
            FLD_SE_PLAY(100);
            WAIT(15);
            FLD_SE_PLAY(100);
            MODEL_WAIT(local63);
            itfMesMngOpenWindow();
            itfMesMngMessage(99) /* HUTOMIMI_01 */;
            itfMesMngCloseWindow();
            WAIT(5);
            CAM_SEL_FOVY(SEARCH_ID("01cam_03"));
            FLD_SE_PLAY(66);
            OBJ_PATH_MOVE(SEARCH_ID("md_01d_04"), SEARCH_ID("01path_01"), 1);
            itfMesMngOpenWindow();
            itfMesMngMessage(100) /* HUTOMIMI_01A */;
            itfMesMngMessage(101) /* HUTOMIMI_02 */;
            itfMesMngMessage(102) /* HUTOMIMI_03 */;
            MODEL_WAIT_MOT(local63, 6);
            MODEL_MOTION2(local63, 5, 0, 0, 0);
            WAIT(15);
            CAM_SEL_FOVY(SEARCH_ID("01cam_17"));
            CAM_PATH_MOVE(SEARCH_ID("01cam_17"), SEARCH_ID("01cam_17_MOTION"));
            itfMesMngMessage(103) /* HUTOMIMI_04 */;
            itfMesMngMessage(104) /* HUTOMIMI_04A */;
            CAM_PATH_WAIT(SEARCH_ID("01cam_17"));
            WAIT(30);
            CAM_SEL_FOVY(SEARCH_ID("01cam_03"));
            MODEL_EXMOTION(local63, 3, 1, 0, 0, 1);
            MODEL_MOTION2(local63, 7, 0, 0, 3);
            itfMesMngMessage(105) /* HUTOMIMI_05 */;
            WAIT(80);
            MODEL_EXMOTION(local63, 3, 0, 5, 5, 1);
            MODEL_WAIT(local63);
            MODEL_MOTION2(local63, 1, 0, 0, 1);
            itfMesMngMessage(106) /* HUTOMIMI_05A */;
            itfMesMngMessage(107) /* HUTOMIMI_06 */;
            itfMesMngCloseWindow();
            FADE_OUT(0, 30);
            WAIT(30);
            FLD_SE_PLAY(66);
            WAIT(30);
            MODEL_CLS(local63);
            MODEL_POS(MODEL_PLAYER(), SEARCH_ID("01pos_20"));
            SET_CHASE_CAMERA();
            CAM_SEL_FOVY(- 1);
            FADE_IN(0, 30);
            WAIT(30);
            itfMesMngOpenWindow();
            itfMesMngMessage(108) /* HUTOMIMI_07 */;
            itfMesMngCloseWindow();
            FLD_BGM_FADE();
            FLD_BGM_PLAY(1);
            SET_ALLPANEL(3);
            PAD_ENABLE();
            return;
        }
    }
}

void 009_crash()
{
    PAD_DISABLE();
    SET_ALLPANEL(0);
    CAM_SEL(SEARCH_ID("01cam_09"));
    local64 = TEX_LOAD("/fld/f/f025/f025_bg01.tmx");
    TEX_ON(local64);
    FADE_IN(0, 5);
    WAIT(5);
    itfMesMngOpenWindow();
    itfMesMngMessage(0) /* NO_MAN1 */;
    itfMesMngCloseWindow();
    FADE_OUT(0, 15);
    WAIT(15);
    SET_CHASE_CAMERA();
    CAM_SEL(- 1);
    TEX_OFF(local64);
    TEX_CLS(local64);
    PAD_ENABLE();
}

void 009_jaaku()
{
    if (BIT_CHK(1435) == 0)
    {
        PAD_DISABLE();
        SET_ALLPANEL(2);
        FLD_BGM_FADE();
        FLD_BGM_PLAY(130);
        MODEL_POS(MODEL_PLAYER(), SEARCH_ID("01pos_17"));
        local65 = MODEL_DSP(6, 303);
        MODEL_SCL_XYZ(local65, 4.0f, 4.0f, 4.0f);
        MODEL_POS(local65, SEARCH_ID("01pos_16"));
        FLD_MODEL_LIGHT(local65);
        CAM_SEL_FOVY(SEARCH_ID("01cam_12"));
        CAM_PATH_MOVE(SEARCH_ID("01cam_12"), SEARCH_ID("01cam_12_MOTION"));
        CAM_PATH_WAIT(SEARCH_ID("01cam_12"));
        WAIT(60);
        itfMesMngOpenWindow();
        itfMesMngMessage(116) /* F025_JAAKU01 */;
        if (itfMesMngSelect(117))
        {
            CAM_SEL_FOVY(SEARCH_ID("01cam_15"));
            MODEL_POS(MODEL_PLAYER(), SEARCH_ID("01pos_19"));
            MODEL_POS(local65, SEARCH_ID("01pos_18"));
            itfMesMngMessage(119) /* F025_JAAKU01_NO */;
        }
        else
        {
            CAM_SEL_FOVY(SEARCH_ID("01cam_15"));
            MODEL_POS(MODEL_PLAYER(), SEARCH_ID("01pos_19"));
            MODEL_POS(local65, SEARCH_ID("01pos_18"));
            itfMesMngMessage(118) /* F025_JAAKU01_YES */;
        }
        itfMesMngCloseWindow();
        MODEL_MOTION2(local65, 5, 10, 10, 1);
        WAIT(5);
        CAM_PATH_MOVE(SEARCH_ID("01cam_15"), SEARCH_ID("01cam_15_MOTION"));
        WAIT(5);
        COMM_217(55);
        WAIT(35);
        BIT_ON(1434);
        BIT_OFF(1438);
        CALL_NEXT(1, 25, 502);
        CALL_BATTLE(714);
        return;
    }
}

void 004_01eve_03()
{
    while (1)
    {
        if (ACT_WIN_DSP(3))
        {
            PAD_DISABLE();
            SET_ALLPANEL(2);
            FADE_OUT(0, 15);
            WAIT(15);
            var0 = MODEL_PLAYER();
            MODEL_POS(var0, SEARCH_ID("01pos_03"));
