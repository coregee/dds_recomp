            MODEL_MOTION2(var0, 11, 10, 10, 1);
            FADE_IN(0, 15);
            WAIT(15);
            WAIT(35);
            FADE_OUT(0, 15);
            WAIT(10);
            CALL_FIELD3(3, "01pos_09");
            return;
        }
        SYNC();
    }
}

