        SET_ALLPANEL(2);
        FLD_MAP_ON(0, 20, 6);
        BGM_VOL_DOWN();
        FADE_OUT(0, 20);
        WAIT(20);
        var0 = MODEL_PLAYER();
        MODEL_POS(var0, SEARCH_ID("01pos_10"));
        var4 = MODEL_DSP(6, 168);
        local80 = EFFBED_LOAD("/fld/f/bin/DEVILGEN.BED");
        CAM_SEL(SEARCH_ID("01cam_01"));
        FADE_IN(0, 20);
        WAIT(30);
        CAM_PATH_MOVE(SEARCH_ID("01cam_01"), SEARCH_ID("01cam_01_MOTION"));
        WAIT(60);
        COMM_217(0);
        EFFECT_POS(local80, SEARCH_ID("01epos_01"));
        EFFBED_START(local80, 0);
        PAD_ACT(1, 170, 10);
        PAD_ACT(0, 1, 10);
        WAIT(10);
        MODEL_A(var4, 0, 0.0f);
        MODEL_POS(var4, SEARCH_ID("01epos_01"));
        FLD_MODEL_LIGHT(var4);
        MODEL_A(var4, 30, 1.0f);
        WAIT(60);
        CAM_SEL(SEARCH_ID("01cam_30"));
        itfMesMngOpenWindow();
        itfMesMngMessage(3) /* CUBE_GARD01: Oh, no you don't! */;
        itfMesMngCloseWindow();
        MODEL_ROT(var4, SEARCH_ID("01epos_05"), 24);
        MODEL_WAIT(var4);
        COMM_217(49);
        MODEL_MOTION2(var4, 4, 0, 5, 0);
        WAIT(30);
        FLD_SE_PLAY(99);
        OBJ_PATH_MOVE(SEARCH_ID("md_01g_01"), SEARCH_ID("01path_01"), 0);
        OBJ_PATH_WAIT(SEARCH_ID("md_01g_01"));
        WAIT(40);
        CAM_SEL(SEARCH_ID("01cam_10"));
        WAIT(20);
        CAM_PATH_MOVE(SEARCH_ID("01cam_10"), SEARCH_ID("01cam_10_MOTION"));
        WAIT(60);
        FLD_SE_PLAY(97);
        FLD_ATARI_OFF(0, 20, "atari_hoji_01");
        FLD_ATARI_ON(0, 20, "atari_hoji_02");
        OBJ_PATH_MOVE(SEARCH_ID("md_hoji_01"), SEARCH_ID("path_hoji_01"), 0);
        OBJ_PATH_MOVE(SEARCH_ID("md_hoji_02"), SEARCH_ID("path_hoji_02"), 0);
        OBJ_PATH_MOVE(SEARCH_ID("md_hoji_03"), SEARCH_ID("path_hoji_03"), 0);
        OBJ_PATH_MOVE(SEARCH_ID("md_hoji_04"), SEARCH_ID("path_hoji_04"), 0);
        OBJ_PATH_WAIT(SEARCH_ID("md_hoji_04"));
        FLD_SE_STOP(97);
        FLD_SE_PLAY(96);
        FLD_MODEL_OFF(0, 0, "md_hoji_11", 1);
        FLD_MODEL_ON(0, 0, "md_hoji_12", 1);
        FLD_MAP_OFF(0, 20, 2);
        FLD_MAP_ON(0, 20, 3);
        WAIT(40);
        BIT_ON(1268);
        itfMesMngOpenWindow();
        itfMesMngMessage(4) /* CUBE_GARD01_01: > The demon has operated the switch. */;
        itfMesMngCloseWindow();
        COMM_217(0);
        EFFECT_POS(local80, SEARCH_ID("01epos_01"));
        EFFBED_START(local80, 0);
        WAIT(10);
        MODEL_A(var4, 0, 1.0f);
        MODEL_A(var4, 30, 0.0f);
        MODEL_CLS(var4);
        WAIT(60);
        FADE_OUT(0, 30);
        WAIT(30);
