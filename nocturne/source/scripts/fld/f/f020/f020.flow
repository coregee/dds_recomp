        FLD_MAP_ON(0, 8, 5);
        FLD_MAP_OFF(0, 8, 1);
    }
    if (BIT_CHK(1251) == 0)
    {
        PAD_DISABLE();
        SET_ALLPANEL(0);
        local64 = MODEL_DSP(6, 118);
        MODEL_POS(local64, SEARCH_ID("01epos_01"));
        FLD_MODEL_LIGHT(local64);
        local65 = MODEL_DSP(6, 52);
        MODEL_POS(local65, SEARCH_ID("01epos_02"));
        FLD_MODEL_LIGHT(local65);
        FLD_NPC_OFF(0, 1, "npc_hoji_01");
        FLD_NPC_OFF(0, 1, "npc_hoji_02");
        FLD_NPC_OFF(0, 2, "npc_hoji_01");
        FLD_NPC_OFF(0, 2, "npc_hoji_02");
        FLD_NPC_OFF(0, 4, "npc_hoji_01");
        FLD_NPC_OFF(0, 4, "npc_hoji_02");
        CAM_SEL(SEARCH_ID("01cam_02"));
        WAIT(5);
        BGM_VOL_DOWN();
        WAIT(10);
        itfMesMngOpenWindow();
        itfMesMngMessage(63) /* SAIDAN_DVL01: Those idiot Mantra demons fell for it hook, line and sinker. */;
        itfMesMngMessage(64) /* SAIDAN_DVL02: Power-shmower. Power's nothing without brains! */;
        itfMesMngCloseWindow();
        WAIT(10);
        CAM_SEL_FOVY(SEARCH_ID("01cam_09"));
        var0 = MODEL_PLAYER();
        MODEL_OFF(var0);
        FLD_MSE_PLAY2(22, 0);
        MODEL_ROT(local65, SEARCH_ID("01epos_04"), 64);
        MODEL_WAIT(local65);
        itfMesMngOpenWindow();
        itfMesMngMessage(65) /* SAIDAN_DVL03: ......Hm? */;
        itfMesMngMessage(66) /* SAIDAN_DVL03_02: Who're you? */;
        MODEL_ROT(local64, SEARCH_ID("01epos_03"), 16);
        MODEL_WAIT(local64);
        itfMesMngCloseWindow();
        WAIT(10);
        itfMesMngOpenWindow();
        itfMesMngMessage(67) /* SAIDAN_DVL04: Hmmm... */;
        itfMesMngMessage(68) /* SAIDAN_DVL04_02: Just our luck... We were getting bored of the Mantra's stupidity. */;
        itfMesMngCloseWindow();
        MODEL_MOTION2(local64, 4, 3, 15, 3);
        MODEL_MOTION2(local65, 15, 3, 15, 3);
        WAIT(22);
        FLD_MSE_PLAY2(22, 1);
        itfMesMngOpenWindow();
        itfMesMngMessage(69) /* SAIDAN_DVL05: Dieeeeeeeeeeee!! */;
        itfMesMngCloseWindow();
        BIT_ON(1251);
        CALL_NEXT(1, 20, 503);
        CALL_BATTLE(144);
        return;
    }
    if (BIT_CHK(1251) == 1 && BIT_CHK(1753) == 0)
    {
        PAD_DISABLE();
        SET_ALLPANEL(0);
        CAM_SEL(SEARCH_ID("01cam_02"));
        WAIT(30);
        itfMesMngOpenWindow();
        itfMesMngMessage(70) /* SAIDAN_SYS01: > You obtained the Yellow Kila. */;
        itfMesMngCloseWindow();
        BIT_ON(979);
        BIT_ON(1753);
        FADE_OUT(0, 30);
        WAIT(30);
        SET_FIX_CAMERA(SEARCH_ID("01cam_01"));
        CAM_SEL(- 1);
        FADE_IN(0, 30);
        WAIT(30);
        SET_ALLPANEL(3);
        PAD_ENABLE();
        return;
    }
    else
    {
        SET_FIX_CAMERA(SEARCH_ID("01cam_01"));
        CAM_SEL(- 1);
    }
}

