void 001_door()
{
    if (BIT_CHK(149) == 0 && BIT_CHK(148) == 0 && BIT_CHK(147) == 0 && BIT_CHK(145) == 0 && BIT_CHK(146) == 0)
    {
        WAIT(1);
        if (BIT_CHK(1874) == 0)
        {
            PAD_DISABLE();
            SET_ALLPANEL(0);
            FLD_MODEL_OFF(0, 0, "md_hoji_02", 0);
            CAM_SEL(SEARCH_ID("01cam_06"));
            CAM_PATH_MOVE(SEARCH_ID("01cam_06"), SEARCH_ID("01cam_06_MOTION"));
            WAIT(220);
            CAM_SEL(SEARCH_ID("01cam_01"));
            CAM_PATH_MOVE(SEARCH_ID("01cam_01"), SEARCH_ID("01cam_01_MOTION"));
            OBJ_PATH_MOVE(SEARCH_ID("atari_hoji_01"), SEARCH_ID("path_hoji_01"), 0);
            FLD_SE_PLAY(96);
            WAIT(20);
            QUAKE_ON(10, 50);
            WAIT(15);
            FADE_OUT(0, 15);
            WAIT(15);
            CAM_SEL(- 1);
            FADE_IN(0, 15);
            WAIT(15);
            SET_ALLPANEL(3);
            BIT_ON(1874);
            PAD_ENABLE();
        }
    }
    if (BIT_CHK(2003) == 0 && BIT_CHK(286) == 1)
    {
        PAD_DISABLE();
        FLD_GIMIC_HOJI(44, 2, 1, 1);
        BIT_ON(2003);
        PAD_ENABLE();
    }
}

