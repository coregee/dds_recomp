        MODEL_MOTION2(var0, 13, 15, 0, 0);
        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        FADE_IN(0, 15);
        WAIT(15);
        MODEL_WAIT(var0);
        MODEL_MOTION2(var0, 9, 10, 10, 3);
        itfMesMngOpenWindow();
        itfMesMngMessage(1) /* DOROP_START: > You landed in an unexpected location. */;
        itfMesMngCloseWindow();
