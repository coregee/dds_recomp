        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        FADE_IN(0, 30);
        WAIT(30);
        SET_ALLPANEL(3);
        PAD_ENABLE();
    }
    if (BIT_CHK(267) == 0)
    {
        FLD_ANIME_OFF(0, 0, "md_hoji_02", 2);
    }
}

