void 018_start()
{
    FLD_NPC_OFF(0, 0, "npc_hoji_01");
    if (BIT_CHK(75) == 1 && BIT_CHK(278) == 0)
    {
        FLD_NPC_ON(0, 0, "npc_hoji_01");
    }
    else if (BIT_CHK(75) == 1 && BIT_CHK(278) == 1)
    {
        FLD_NPC_OFF(0, 0, "npc_hoji_01");
    }
    if (BIT_CHK(1120) == 1)
    {
        return;
    }
    if (BIT_CHK(1130) == 1)
    {
        return;
    }
    PAD_DISABLE();
    FLD_TITLE_START2(16, 0);
    SET_ALLPANEL(0);
    ENCOUNT_OFF();
    CAM_SEL(SEARCH_ID("01cam_02"));
    local163 = MODEL_PLAYER();
    MODEL_MOTION2(local163, 4, 3, 15, 1);
    MODEL_MOVE(local163, SEARCH_ID("01pos_05"), 0, 75, 8);
    WAIT(80);
    MODEL_MOTION2(local163, 8, 3, 15, 1);
    WAIT(40);
    FADE_OUT(0, 30);
    WAIT(30);
    BIT_ON(1120);
    SET_CHASE_CAMERA();
    CAM_SEL(- 1);
    if (BIT_CHK(1184) == 1)
    {
        FADE_IN(0, 30);
        WAIT(30);
        ENCOUNT_ON();
        PAD_ENABLE();
        SET_ALLPANEL(3);
        return;
    }
    if (prm_UDV_CHECK(1) == 0)
    {
        FADE_IN(0, 30);
        WAIT(30);
        ENCOUNT_ON();
        PAD_ENABLE();
        SET_ALLPANEL(3);
        return;
    }
    else
    {
        FLD_BGM_FADE();
        FLD_BGM_PLAY(134);
        local165 = prm_UDV_GETID(1);
        itfMesMngSetVarScr(0, local165, 1);
        local164 = MODEL_DSP(6, local165);
        MODEL_POS(local164, SEARCH_ID("01pos_06"));
        FLD_MODEL_LIGHT(local164);
        FADE_IN(0, 30);
        WAIT(30);
        itfMesMngOpenWindow();
        itfMesMngMessage(41) /* PIX_MES_01 */;
        MODEL_POS(local164, SEARCH_ID("01pos_07"));
        MODEL_ROT(local164, SEARCH_ID("01pos_07"), 10);
        CAM_SEL(SEARCH_ID("01cam_04"));
        itfMesMngOpenWindow();
        itfMesMngMessage(42) /* PIX_MES_02 */;
        if (itfMesMngSelect(43) == 1)
        {
            itfMesMngMessage(50) /* PIX_MES_08 */;
            if (itfMesMngSelect(51) == 0)
            {
                itfMesMngMessage(52) /* PIX_MES_09 */;
                itfMesMngCloseWindow();
                prm_UDV_DELETE_OK(1);
            }
            else
            {
                itfMesMngMessage(53) /* PIX_MES_10 */;
                BIT_ON(2352);
                itfMesMngMessage(47) /* DH_ANKU */;
                prm_DH_PLUS(3);
                MODEL_POS(local163, SEARCH_ID("01pos_09"));
                MODEL_MOTION2(local164, 16, 20, 20, 1);
                MODEL_ROT(local164, SEARCH_ID("01pos_08"), 10);
                CAM_SEL(SEARCH_ID("01cam_05"));
                itfMesMngMessage(54) /* PIX_MES_11 */;
                if (prm_UDV_GETID(1) == 116)
                {
                    COMM_217(70);
                }
                else
                {
                    COMM_217(11);
                }
                MODEL_WAIT(local164);
                MODEL_MOVE2(local164, SEARCH_ID("01path_01"), 1, 0, 0, 80, 32);
                itfMesMngCloseWindow();
                prm_UDV_LEAVE(1);
            }
        }
        else
        {
            itfMesMngMessage(44) /* PIX_MES_03 */;
            if (itfMesMngSelect(45) == 1)
            {
                MODEL_ROT(local164, SEARCH_ID("01pos_07"), 10);
                itfMesMngMessage(49) /* PIX_MES_07 */;
                itfMesMngCloseWindow();
                prm_UDV_DELETE_OK(1);
            }
            else
            {
                itfMesMngMessage(46) /* PIX_MES_05 */;
                BIT_ON(2352);
                itfMesMngMessage(47) /* DH_ANKU */;
                prm_DH_PLUS(3);
                MODEL_POS(local163, SEARCH_ID("01pos_09"));
                MODEL_MOTION2(local164, 16, 20, 20, 1);
                MODEL_ROT(local164, SEARCH_ID("01pos_08"), 10);
                CAM_SEL(SEARCH_ID("01cam_05"));
                itfMesMngMessage(48) /* PIX_MES_06 */;
                if (prm_UDV_GETID(1) == 116)
                {
                    COMM_217(70);
                }
                else
                {
                    COMM_217(11);
                }
                MODEL_WAIT(local164);
                MODEL_MOVE2(local164, SEARCH_ID("01path_01"), 1, 0, 0, 80, 32);
                itfMesMngCloseWindow();
                prm_UDV_LEAVE(1);
            }
        }
        BIT_ON(1130);
        FADE_OUT(0, 30);
        WAIT(30);
        MODEL_CLS(local164);
        MODEL_SHADOW_OFF(local164);
        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        FADE_IN(0, 30);
        WAIT(30);
        ENCOUNT_ON();
        PAD_ENABLE();
        FLD_BGM_FADE();
        FLD_BGM_PLAY(1);
        SET_ALLPANEL(3);
        return;
    }
