        itfMesMngMessage(75) /* KEHAI */;
        if (itfMesMngSelect(76) == 0)
        {
            itfMesMngMessage(77) /* KEHAI2 */;
            if (itfMesMngSelect(76) == 0)
            {
                itfMesMngCloseWindow();
                FADE_OUT(0, 15);
