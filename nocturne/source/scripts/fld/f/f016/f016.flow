                MODEL_POS(MODEL_DSP(2, 20), SEARCH_ID("01pos_02"));
                MODEL_MOTION2(var0, 12, 3, 15, 3);
                WAIT(80);
                FLD_BGM_FADE();
                CALL_NEXT(1, 16, 747);
                CALL_EVENT(747);
                return;
            }
        }
        itfMesMngMessage(78) /* TRY_RUNAWAY */;
        if (GET_MOON16() == 8)
        {
            itfMesMngMessage(80) /* SIPPAI */;
            itfMesMngMessage(82) /* SIPPAI_KOTEN */;
        }
        else if (RND(100) > 60)
        {
            itfMesMngMessage(80) /* SIPPAI */;
        }
        else
        {
            itfMesMngMessage(79) /* RUNAWAY */;
            itfMesMngCloseWindow();
            SET_ALLPANEL(3);
            BIT_ON(1881);
            PAD_ENABLE();
            return;
        }
        itfMesMngCloseWindow();
        FADE_OUT(0, 15);
        WAIT(15);
        var0 = MODEL_PLAYER();
        MODEL_POS(var0, SEARCH_ID("01pos_02"));
        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        FADE_IN(0, 15);
