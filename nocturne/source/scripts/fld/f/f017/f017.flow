            CAM_SEL_FOVY(SEARCH_ID("01cam_06"));
            itfMesMngMessage(15) /* BAFO_02: ............ */;
            itfMesMngMessage(16) /* BAFO_03: > Baphomet begins to chant... */;
            itfMesMngCloseWindow();
            FADE_OUT(0, 30);
            WAIT(30);
            CAM_SEL_FOVY(SEARCH_ID("01cam_10"));
            FADE_IN(0, 30);
            WAIT(30);
            MODEL_MOTION2(local39, 14, 30, 30, 1);
            itfMesMngOpenWindow();
            itfMesMngMessage(17) /* BAFO_04: Awaken, o mighty one... Hear my words... */;
            QUAKE_ON(0, 50);
            PAD_ACT(1, 50, 300);
            itfMesMngMessage(18) /* BAFO_05: Come forth from the depths of shadow... */;
            QUAKE_ON(0, 100);
            PAD_ACT(1, 75, 300);
            itfMesMngMessage(19) /* BAFO_06: And submit to my will! */;
            MODEL_MOTION2(local39, 2, 30, 30, 1);
            QUAKE_ON(0, 200);
            PAD_ACT(1, 100, 300);
            CAM_SEL_FOVY(SEARCH_ID("01cam_11"));
            itfMesMngMessage(20) /* BAFO_07: ............ */;
            COMM_217(53);
            MODEL_MOTION2(local39, 1, 10, 10, 1);
            WAIT(30);
            FADE_OUT(1, 5);
            WAIT(5);
            FADE_IN(1, 5);
            WAIT(5);
            FADE_OUT(1, 5);
            WAIT(5);
            WAIT(10);
            EFFECT_POS(local41, SEARCH_ID("01pos_06"));
            COMM_217(0);
            PAD_ACT(1, 170, 10);
            PAD_ACT(0, 1, 10);
            MODEL_MOTION2(var0, 9, 10, 10, 1);
            MODEL_MOTION2(local37, 1, 10, 10, 1);
            MODEL_MOTION2(local38, 2, 10, 10, 1);
            MODEL_MOTION2(local39, 0, 10, 10, 1);
            MODEL_POS(local40, SEARCH_ID("01pos_06"));
            FLD_MODEL_LIGHT(local40);
            QUAKE_ON(0, 0);
            itfMesMngCloseWindow();
            EFFBED_START(local41, 0);
            FADE_IN(1, 15);
            FLD_BGM_FADE();
            FLD_BGM_PLAY(128);
            CAM_PATH_MOVE(SEARCH_ID("01cam_11"), SEARCH_ID("01cam_11_MOTION"));
            CAM_PATH_WAIT(SEARCH_ID("01cam_11"));
            WAIT(60);
            itfMesMngOpenWindow();
            itfMesMngMessage(21) /* MAARA_01: ........................ */;
            CAM_SEL_FOVY(SEARCH_ID("01cam_06"));
            itfMesMngMessage(22) /* BAFO_08: *chuckle* */;
            CAM_SEL_FOVY(SEARCH_ID("01cam_09"));
            itfMesMngMessage(23) /* ALL: Ahhhhhhhhhhhhhhhhh! Run away!!!! */;
            CAM_SEL_FOVY(SEARCH_ID("01cam_05"));
            itfMesMngMessage(24) /* MAARA_02: ...Blarg......Blug...... ......Yo...u...... */;
            FLD_MSE_PLAY2(53, 1);
            MODEL_MOTION2(local40, 4, 0, 0, 1);
            CAM_PATH_MOVE(SEARCH_ID("01cam_05"), SEARCH_ID("01cam_05_MOTION"));
            WAIT(30);
            BIT_ON(1160);
            CALL_NEXT(1, 17, 500);
            CALL_BATTLE(713);
            return;
        }
    }
    else
    {
        FLD_BGM_FADE();
        FLD_BGM_PLAY(130);
        itfMesMngOpenWindow();
        itfMesMngMessage(25) /* RUNAWAY: > Baphomet and the Manikins ran away. */;
        itfMesMngCloseWindow();
        FADE_OUT(0, 30);
        WAIT(30);
        BIT_ON(1154);
        FLD_BGM_FADE();
        FLD_BGM_PLAY(1);
        CALL_FIELD2(1, "01pos_04");
        return;
    }
}

