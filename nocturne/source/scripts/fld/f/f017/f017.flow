void 009_start()
{
    PAD_DISABLE();
    SET_ALLPANEL(0);
    if (BIT_CHK(1160) == 0)
    {
        local39 = MODEL_DSP(6, 108);
        MODEL_POS(local39, SEARCH_ID("01pos_02"));
