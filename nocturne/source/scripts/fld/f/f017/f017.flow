        FLD_MODEL_LIGHT(local37);
        local38 = MODEL_DSP(3, 5);
        MODEL_POS(local38, SEARCH_ID("01pos_04"));
        FLD_MODEL_LIGHT(local38);
        var0 = MODEL_PLAYER();
        MODEL_POS(var0, SEARCH_ID("01pos_07"));
        CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
        FLD_BGM_FADE();
        FLD_BGM_PLAY(130);
        itfMesMngOpenWindow();
        itfMesMngMessage(2) /* AYASII2: > A ceremony is about to start. It seems very fishy indeed... */;
        itfMesMngCloseWindow();
