        }
        else
        {
            itfMesMngMessage(4) /* MANE_A_01: Dammit! Dammit! Dammit! */;
            itfMesMngMessage(5) /* MANE_B_01: Right on! It's payback time! */;
            CAM_SEL_FOVY(SEARCH_ID("01cam_06"));
            itfMesMngMessage(6) /* BAFO_01: ............ */;
            CAM_SEL_FOVY(SEARCH_ID("01cam_03"));
            itfMesMngMessage(7) /* MANE_A_02: Quit your stallin'! */;
            itfMesMngMessage(8) /* MANE_B_02: That's right, Mr. Baphomet. Just like the guy on the right said! */;
            CAM_SEL_FOVY(SEARCH_ID("01cam_07"));
            MODEL_POS(local37, SEARCH_ID("01pos_11"));
            MODEL_POS(local38, SEARCH_ID("01pos_10"));
            itfMesMngMessage(9) /* MANE_B_03: You there! You tell him, too! */;
        }
        if (itfMesMngSelect(10) /* MANE_B_03_SEL: Hurry it up. / Take your time. */)
        {
            CAM_SEL_FOVY(SEARCH_ID("01cam_06"));
            itfMesMngMessage(11) /* MAFO_NO: *chuckle* The demon boy is right. We shouldn't daaaash into things! */;
            CAM_SEL_FOVY(SEARCH_ID("01cam_07"));
            MODEL_POS(local37, SEARCH_ID("01pos_11"));
            MODEL_POS(local38, SEARCH_ID("01pos_10"));
            itfMesMngMessage(12) /* MANE_B_03_NO: Hey! Don't tell him that! Get outta here! */;
            BIT_ON(1165);
            FADE_OUT(0, 15);
            WAIT(15);
            FLD_BGM_FADE();
            FLD_BGM_PLAY(1);
            CALL_FIELD2(1, "01pos_04");
            return;
        }
        else
        {
            CAM_SEL_FOVY(SEARCH_ID("01cam_03"));
            MODEL_POS(local37, SEARCH_ID("01pos_03"));
            MODEL_POS(local38, SEARCH_ID("01pos_04"));
            local40 = MODEL_DSP(6, 321);
            MODEL_POS(local40, SEARCH_ID("01pos_08"));
            FLD_MODEL_LIGHT(local40);
            local41 = EFFBED_LOAD("/fld/f/bin/DEVILGEN.BED");
