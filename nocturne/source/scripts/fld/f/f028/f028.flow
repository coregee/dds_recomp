    if (BIT_CHK(1527) == 0 || BIT_CHK(1515) == 1)
    {
        return;
    }
    else
    {
        PAD_DISABLE();
        SET_ALLPANEL(0);
        CAM_SEL(SEARCH_ID("01cam_03"));
        WAIT(10);
        itfMesMngOpenWindow();
        FLD_SE_PLAY(96);
        itfMesMngMessage(7) /* HIJIRI_SYS_01 */;
        itfMesMngMessage(8) /* HIJIRI_01 */;
        if (itfMesMngSelect(9) == 0)
        {
            itfMesMngMessage(10) /* HIJIRI_01_YES */;
        }
        else
        {
            itfMesMngMessage(11) /* HIJIRI_01_NO */;
        }
        itfMesMngMessage(12) /* HIJIRI_02 */;
        itfMesMngMessage(13) /* HIJIRI_SYS_02 */;
        itfMesMngCloseWindow();
        FADE_OUT(0, 20);
        WAIT(20);
        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        FADE_IN(0, 20);
        WAIT(20);
        BIT_OFF(1527);
        BIT_ON(1515);
        SET_ALLPANEL(3);
        PAD_ENABLE();
        return;
    }
}

void 011_01eve_02()
{
    if (BIT_CHK(1516) == 0)
    {
        PAD_DISABLE();
        SET_ALLPANEL(2);
        FADE_OUT(0, 20);
        WAIT(20);
        local36 = MODEL_DSP(6, 257);
        local37 = EFFBED_LOAD("/fld/f/bin/DEVILGEN.BED");
        var0 = MODEL_PLAYER();
        MODEL_POS(var0, SEARCH_ID("01pos_50"));
        CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
        MODEL_MOTION2(var0, 4, 3, 15, 1);
        MODEL_MOVE(var0, SEARCH_ID("01pos_51"), 0, 30, 0);
        WAIT(10);
        FADE_IN(0, 20);
        WAIT(30);
        MODEL_MOTION2(var0, 9, 3, 15, 1);
        WAIT(10);
        FLD_BGM_FADE();
        FLD_BGM_PLAY(128);
        QUAKE_ON(60, 50);
        PAD_ACT(1, 70, 300);
        WAIT(20);
        EFFECT_POS(local37, SEARCH_ID("01pos_52"));
        EFFBED_START(local37, 0);
        COMM_217(0);
        WAIT(10);
        MODEL_A(local36, 0, 0.0f);
        MODEL_POS(local36, SEARCH_ID("01pos_52"));
        FLD_MODEL_LIGHT(local36);
        QUAKE_ON(15, 500);
        PAD_ACT(1, 170, 10);
        PAD_ACT(0, 1, 10);
        MODEL_A(local36, 30, 1.0f);
        WAIT(80);
        CAM_SEL_FOVY(SEARCH_ID("01cam_03"));
        WAIT(20);
        MODEL_POS(var0, SEARCH_ID("01pos_54"));
        itfMesMngOpenWindow();
        itfMesMngMessage(14) /* SPECTOR01 */;
        itfMesMngCloseWindow();
        WAIT(10);
        CAM_SEL_FOVY(SEARCH_ID("01cam_04"));
        WAIT(20);
        itfMesMngOpenWindow();
        itfMesMngMessage(15) /* SPECTOR02 */;
        itfMesMngCloseWindow();
        MODEL_MOTION2(local36, 3, 0, 6, 3);
        WAIT(4);
        CAM_PATH_MOVE(SEARCH_ID("01cam_04"), SEARCH_ID("01cam_04_MOTION"));
        WAIT(20);
        BIT_ON(1516);
        CALL_NEXT(1, 28, 500);
        CALL_BATTLE(266);
        return;
    }
}

void 011_01eve_03()
{
    if (BIT_CHK(66) == 1)
    {
        return;
    }
    else
    {
        PAD_DISABLE();
        SET_ALLPANEL(2);
        FADE_OUT(0, 20);
        WAIT(20);
        var0 = MODEL_PLAYER();
        MODEL_POS(var0, SEARCH_ID("01pos_56"));
        MODEL_MOTION2(var0, 9, 3, 15, 2);
        CAM_SEL(SEARCH_ID("01cam_05"));
        local39 = MODEL_DSP(6, 338);
        FADE_IN(0, 20);
        WAIT(40);
        MODEL_A(local39, 0, 0.0f);
        MODEL_SCL_XYZ(local39, 10, 10, 10);
        MODEL_POS(local39, SEARCH_ID("01pos_55"));
        FLD_MODEL_LIGHT(local39);
        MODEL_A(local39, 30, 1.0f);
        WAIT(50);
        itfMesMngOpenWindow();
        itfMesMngMessage(24) /* MONBAN1 */;
        if (BIT_CHK(1532))
        {
            itfMesMngMessage(25) /* MONBAN1_2ND */;
        }
        BIT_ON(1532);
        itfMesMngMessage(26) /* MONBAN1_Q */;
        local38 = itfMesMngSelect(27);
        if (local38 == 0)
        {
            itfMesMngMessage(28) /* MONBAN1_Y */;
        }
        else if (local38 == 1)
        {
            itfMesMngMessage(29) /* MONBAN1_N */;
            FADE_OUT(0, 30);
            WAIT(30);
            MODEL_CLS(local39);
            MODEL_POS(var0, SEARCH_ID("01pos_57"));
            SET_CHASE_CAMERA();
            CAM_SEL(- 1);
            itfMesMngCloseWindow();
            FADE_IN(0, 30);
            WAIT(30);
            PAD_ENABLE();
            SET_ALLPANEL(3);
            return;
        }
        else
        {
            itfMesMngMessage(30) /* MONBAN1_MUSI */;
            POINT_ADD(2, 1);
        }
        itfMesMngMessage(31) /* MONBAN2 */;
        local38 = itfMesMngSelect(32);
        if (local38 == 0)
        {
            itfMesMngMessage(33) /* MONBAN2_NANORU */;
        }
        else
        {
            itfMesMngMessage(34) /* MONBAN2_MUSI */;
            POINT_ADD(2, 1);
        }
        itfMesMngMessage(35) /* MONBAN3 */;
        local38 = itfMesMngSelect(36);
        if (local38 == 0)
        {
            itfMesMngMessage(37) /* MONBAN3_Y */;
            POINT_ADD(2, 3);
        }
        else if (local38 == 1)
        {
            itfMesMngMessage(38) /* MONBAN3_N */;
        }
        else
        {
            itfMesMngMessage(39) /* MONBAN3_MUSI */;
            POINT_ADD(2, 1);
        }
        itfMesMngMessage(40) /* MONBAN4 */;
        local38 = itfMesMngSelect(41);
        if (local38 == 0)
        {
            itfMesMngMessage(42) /* MONBAN4_Y */;
            POINT_ADD(2, 3);
        }
        else if (local38 == 1)
        {
            itfMesMngMessage(43) /* MONBAN4_N */;
        }
        else
        {
            itfMesMngMessage(44) /* MONBAN4_MUSI */;
        }
        itfMesMngCloseWindow();
        CAM_SEL(SEARCH_ID("01cam_06"));
        MODEL_A(local39, 30, 0.0f);
        WAIT(30);
        MODEL_CLS(local39);
        WAIT(20);
        FADE_OUT(0, 20);
        WAIT(20);
        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        FADE_IN(0, 20);
        WAIT(20);
        itfMesMngOpenWindow();
        itfMesMngMessage(45) /* MONBAN_END_SYS */;
        itfMesMngCloseWindow();
        BIT_ON(66);
        SET_ALLPANEL(3);
        PAD_ENABLE();
        return;
    }
}

