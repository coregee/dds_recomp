void 029_01eve_01()
{
    if (BIT_CHK(1681) == 0)
    {
        BIT_ON(1681);
        PAD_DISABLE();
        SET_ALLPANEL(2);
        FADE_OUT(0, 15);
        WAIT(15);
        MODEL_POS(MODEL_PLAYER(), SEARCH_ID("01pos_04"));
        CAM_SEL_FOVY(SEARCH_ID("01cam_03"));
        FADE_IN(0, 15);
        local87 = MODEL_DSP(6, 2);
        local88 = EFFBED_LOAD("/fld/f/bin/DEVILGEN.BED");
        itfMesMngOpenWindow();
        itfMesMngMessage(35) /* KANMONMAE: O Demi-fiend...... Thou hast set foot into my chamber of judgement. */;
        FLD_BGM_FADE();
        FLD_BGM_PLAY(128);
        QUAKE_ON(0, 50);
        PAD_ACT(1, 70, 300);
        FLD_SE_PLAY(57);
        WAIT(100);
        FLD_SE_STOP(57);
        itfMesMngCloseWindow();
        PAD_ACT(1, 170, 10);
        PAD_ACT(0, 1, 10);
        COMM_217(0);
        EFFECT_POS(local88, SEARCH_ID("01pos_03"));
        EFFBED_START(local88, 0);
        WAIT(5);
        MODEL_A(local87, 0, 0);
        MODEL_POS(local87, SEARCH_ID("01pos_03"));
        FLD_MODEL_LIGHT(local87);
        MODEL_SCL_XYZ(local87, 2, 2, 2);
        MODEL_A(local87, 15, 1);
        CAM_PATH_MOVE(SEARCH_ID("01cam_03"), SEARCH_ID("01cam_03_MOTION"));
        QUAKE_ON(15, 400);
        CAM_PATH_WAIT(SEARCH_ID("01cam_03"));
        WAIT(70);
        itfMesMngOpenWindow();
        itfMesMngMessage(36) /* KANMON01: I am the arbiter who enforces the law known as the Prophecy of Miroku. */;
        CAM_SEL_FOVY(SEARCH_ID("01cam_04"));
        itfMesMngMessage(37) /* KANMON02: But, darest thou, a demon, attempt to create the new world? */;
        if (itfMesMngSelect(38) /* KANMON_SEL: Of course I'm a demon. / No, I'm not a demon. */ == 0)
        {
            itfMesMngMessage(39) /* KANMON03: Then {firstname 0}, dost thou accept that thy heart is demonic? */;
            if (itfMesMngSelect(40) /* KANMON_SEL02: Demon to the bone. / No, it's not. */ == 0)
            {
                itfMesMngMessage(41) /* KANMON04: Finally, allow me to ask thee, demon. */;
                if (itfMesMngSelect(42) /* KANMON_SEL03: I wouldn't dream of it. / I'm in a creation mood. */ == 0)
                {
                    CAM_SEL_FOVY(SEARCH_ID("01cam_05"));
                    itfMesMngMessage(43) /* KANMONGOODEND: Good, now look at me-- */;
                    MODEL_MOTION2(local87, 4, 0, 5, 3);
                    WAIT(5);
                    COMM_217(64);
                    CAM_PATH_MOVE(SEARCH_ID("01cam_05"), SEARCH_ID("01cam_05_MOTION"));
                    WAIT(25);
                    itfMesMngCloseWindow();
                    BIT_ON(2329);
                    CALL_NEXT(1, 33, 554);
                    CALL_BATTLE(970);
                    return;
                }
                else
                {
                    CAM_SEL_FOVY(SEARCH_ID("01cam_05"));
                    itfMesMngMessage(44) /* KANMONBADEND: 'Tis true that thou art the bane of creation... */;
                    MODEL_MOTION2(local87, 4, 0, 5, 3);
                    WAIT(5);
                    COMM_217(64);
                    CAM_PATH_MOVE(SEARCH_ID("01cam_05"), SEARCH_ID("01cam_05_MOTION"));
                    WAIT(25);
                    itfMesMngCloseWindow();
                    BIT_ON(2329);
                    CALL_NEXT(1, 33, 554);
                    CALL_BATTLE(970);
                    return;
                }
            }
            else
