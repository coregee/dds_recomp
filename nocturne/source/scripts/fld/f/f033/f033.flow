        MODEL_POS(MODEL_PLAYER(), SEARCH_ID("01pos_12"));
        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        itfMesMngOpenWindow();
        FADE_IN(0, 15);
        WAIT(15);
        itfMesMngMessage(47) /* STARTMESSEGE01: ...O lost one. */;
        CAM_SEL_FOVY(SEARCH_ID("01cam_10"));
        CAM_PATH_MOVE(SEARCH_ID("01cam_10"), SEARCH_ID("01cam_10_MOTION"));
        itfMesMngMessage(48) /* STARTMESSEGE02: I warn thee, leave this place at once. */;
        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        itfMesMngMessage(49) /* STARTMESSEGE03: > You cannot hear the voice anymore. */;
        itfMesMngCloseWindow();
        SET_ALLPANEL(3);
        PAD_ENABLE();
    }
}

