void 007_start()
{
    if (BIT_CHK(1670) == 1)
    {
        FLD_MODEL_OFF(33, 7, "md_hoji_01", 0);
    }
    if (BIT_CHK(1670) == 0)
    {
        if (BIT_CHK(1684) == 0)
        {
            FLD_MODEL_ON(33, 7, "md_hoji_02", 0);
        }
        else
        {
            if (BIT_CHK(1680) == 0)
            {
                PAD_DISABLE();
                BIT_ON(1680);
                CAM_SEL_FOVY(SEARCH_ID("01cam_01"));
                FLD_MODEL_OFF(33, 7, "md_hoji_01", 0);
                SET_ALLPANEL(2);
                FLD_BGM_FADE();
                FLD_BGM_PLAY(128);
                itfMesMngOpenWindow();
                itfMesMngMessage(5) /* KIYAGATTA: You made it this far without dying... */;
                FLD_SE_PLAY(98);
                FLD_MODEL_OFF(33, 7, "md_hoji_02", 2);
                FLD_ATARI_OFF(33, 7, "atari_hoji_01");
                WAIT(45);
                itfMesMngMessage(6) /* IKASENAI: I praise you. I haven't had such a fun hunt in quite a while. */;
                FLD_SE_PLAY(96);
                FLD_MODEL_ON(33, 7, "md_hoji_01", 1);
                WAIT(60);
                CAM_SEL_FOVY(SEARCH_ID("01cam_04"));
                var0 = MODEL_PLAYER();
                MODEL_POS(var0, SEARCH_ID("01pos_10"));
                itfMesMngOpenWindow();
                itfMesMngMessage(7) /* OOKUMA_DOUZOU: ...But, I cannot let you go any further. */;
                BIT_ON(1670);
                BIT_ON(2326);
                CALL_NEXT(1, 33, 551);
                CALL_BATTLE(985);
                return;
            }
        }
    }
}

