            {
                itfMesMngMessage(49) /* F21_AREA7_NPC1: Are you here because you heard that Commander Hikawa is summoning a god? */;
                if (itfMesMngSelect(50) /* F21_AREA7_NPC1_SEL: Yes. / No. */ == 0)
                {
