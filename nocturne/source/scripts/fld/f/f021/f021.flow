void 022_start()
{
    if (BIT_CHK(1283) == 0)
    {
        if (BIT_CHK(1286) == 1)
        {
            FLD_ATARI_OFF(0, 0, "atari_hoji_01");
            FLD_MODEL_OFF(0, 0, "md_hoji_01", 0);
            FLD_ATARI_OFF(0, 0, "atari_hoji_02");
            FLD_MODEL_OFF(0, 0, "md_hoji_02", 0);
            FLD_ATARI_ON(0, 0, "atari_hoji_03");
            FLD_MODEL_ON(0, 0, "md_hoji_03", 0);
            FLD_MODEL_ON2(21, 22, 1);
            FLD_NPC_OFF(21, 22, "npc_hoji_01");
            FLD_NPC_ON(21, 22, "npc_hoji_03");
            FLD_NPC_OFF(21, 22, "npc_hoji_02");
            return;
        }
        else if (BIT_CHK(1285) == 1)
        {
            FLD_ATARI_OFF(0, 0, "atari_hoji_01");
            FLD_MODEL_OFF(0, 0, "md_hoji_01", 0);
            FLD_ATARI_ON(0, 0, "atari_hoji_02");
            FLD_MODEL_ON(0, 0, "md_hoji_02", 0);
            FLD_ATARI_ON(0, 0, "atari_hoji_03");
            FLD_MODEL_ON(0, 0, "md_hoji_03", 0);
            FLD_MODEL_ON2(21, 22, 1);
            FLD_NPC_OFF(21, 22, "npc_hoji_01");
            FLD_NPC_OFF(21, 22, "npc_hoji_03");
            FLD_NPC_OFF(21, 22, "npc_hoji_02");
            return;
        }
        FLD_ATARI_OFF(0, 0, "atari_hoji_02");
        FLD_MODEL_OFF(0, 0, "md_hoji_02", 0);
        FLD_ATARI_OFF(0, 0, "atari_hoji_03");
        FLD_MODEL_OFF(0, 0, "md_hoji_03", 0);
        COMM_10A(21, 22, 1);
        FLD_NPC_ON(21, 22, "npc_hoji_01");
        FLD_NPC_OFF(21, 22, "npc_hoji_03");
        FLD_NPC_OFF(21, 22, "npc_hoji_02");
        return;
    }
}

void 022_01npc_01()
{
    while (1)
    {
        if (DIR_HIT_CNTR(0) == 1)
        {
            if (ACT_WIN_DSP(1) == 1)
            {
                if (BIT_CHK(1282) == 0)
                {
                    PAD_DISABLE();
                    FLD_BGM_FADE();
                    FLD_BGM_PLAY(130);
                    SET_ALLPANEL(6);
                    itfMesMngOpenWindow();
                    itfMesMngMessage(9) /* SIGE_01: I'm a prospector that's a lookin' fer buried treasure 'round these pa... */;
                    FLD_ANAHORI_INIT();
                    local37 = FLD_ANAHORI_GET();
                    if (local37 == 0)
                    {
                        itfMesMngCloseWindow();
                        FLD_BGM_FADE();
                        FLD_BGM_PLAY(1);
                        PAD_ENABLE();
                        SET_ALLPANEL(7);
                        return;
                    }
                    if (BIT_CHK(1287) == 0)
                    {
                        itfMesMngMessage(10) /* SIGE_01B: ............!! */;
                        BIT_ON(1287);
                    }
                    else
                    {
                        itfMesMngMessage(28) /* SIGE_10: ............ */;
                    }
                    if (itfMesMngSelect(11) /* SIGE_01_SEL: My demon's your demon. / Get your own demon. */ == 0)
                    {
                        itfMesMngMessage(13) /* SIGE_01_YES: Really!? Hoo-doggie! Thanks! */;
                        while (1)
                        {
                            itfMesMngSetVarScr(0, local37, 1);
                            itfMesMngMessage(14) /* SIGE_01C: *whistle* */;
                            local36 = itfMesMngSelect(15) /* SIGE_01C_SEL: No, not that one. / Yeah, go for it. / Just forget it. */;
                            if (local36 == 0)
                            {
                                FLD_ANAHORI_NEXT();
                                local37 = FLD_ANAHORI_GET();
                            }
                            else if (local36 == 1)
                            {
                                BIT_ON(1282);
                                FLD_ANAHORI_DEL();
                                if (BIT_CHK(1284) == 0)
                                {
                                    itfMesMngMessage(16) /* SIGE_01D: Hmmm... */;
                                }
                                else
                                {
                                    itfMesMngMessage(17) /* SIGE_01E: Whoa! */;
                                }
                                itfMesMngCloseWindow();
                                FLD_BGM_FADE();
                                FLD_BGM_PLAY(1);
                                PAD_ENABLE();
                                SET_ALLPANEL(7);
                                return;
                            }
                            else if (local36 == 2)
                            {
