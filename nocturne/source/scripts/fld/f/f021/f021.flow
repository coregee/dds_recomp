                itfMesMngMessage(103) /* F021_DEVIL02_02: Commander Hikawa has summoned the famous god, Ahriman... */;
            }
            itfMesMngCloseWindow();
            SET_ALLPANEL(7);
            PAD_ENABLE();
        }
        SYNC();
    }
}

