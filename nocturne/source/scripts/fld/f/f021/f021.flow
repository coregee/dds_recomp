        DIST_BLUR_PARA(60, 166, 5, 0.062f, 0, 0.13f, 1);
        DIST_BLUR_RGBA(212, 102, 102, 31);
        DIST_BLUR_AREA(226, 0, 0);
        DIST_BLUR_ON(15);
        WAIT(45);
        DIST_BLUR_OFF(30);
        WAIT(30);
        itfMesMngOpenWindow();
        itfMesMngMessage(56) /* FIRE_YURE: > The flames of the Candelabrum of Sovereignty are flickering wildly... */;
        itfMesMngCloseWindow();
        BIT_OFF(1882);
        SET_ALLPANEL(3);
        PAD_ENABLE();
    }
}

void 001_01eve_04()
{
    if (BIT_CHK(280) == 0 && BIT_CHK(1882) == 0)
    {
        PAD_DISABLE();
        SET_ALLPANEL(2);
        itfMesMngOpenWindow();
        itfMesMngMessage(57) /* KEHAI: > You can feel the presence of a terrifying demon... */;
        if (itfMesMngSelect(58) /* YES_NO_SEL: Yes. / No. */ == 0)
        {
            itfMesMngMessage(59) /* KEHAI2: > Are you sure? */;
            if (itfMesMngSelect(58) /* YES_NO_SEL: Yes. / No. */ == 0)
            {
                itfMesMngCloseWindow();
                FADE_OUT(0, 15);
                WAIT(15);
                var0 = MODEL_PLAYER();
                MODEL_POS(var0, SEARCH_ID("01pos_07"));
                SET_CHASE_CAMERA();
                CAM_SEL(- 1);
                FADE_IN(0, 15);
                WAIT(15);
                COMM_217(82);
                MODEL_POS(MODEL_DSP(2, 20), SEARCH_ID("01pos_07"));
                MODEL_MOTION2(var0, 12, 3, 15, 3);
                WAIT(80);
                FLD_BGM_FADE();
                CALL_NEXT(1, 21, 748);
                CALL_EVENT(748);
                return;
            }
        }
        itfMesMngMessage(60) /* TRY_RUNAWAY: > ............ */;
        if (GET_MOON16() == 8)
        {
            itfMesMngMessage(62) /* SIPPAI: > It looks like you won't be able to escape... */;
            itfMesMngMessage(64) /* SIPPAI_KOTEN: The flames of the candelabrum burn passionately! You won't escape! */;
        }
        else if (RND(100) > 60)
        {
            itfMesMngMessage(62) /* SIPPAI: > It looks like you won't be able to escape... */;
        }
        else
        {
            itfMesMngMessage(61) /* RUNAWAY: > It looks like you'll be able to get away. */;
            itfMesMngCloseWindow();
            SET_ALLPANEL(3);
            BIT_ON(1882);
            PAD_ENABLE();
            return;
        }
        itfMesMngCloseWindow();
        FADE_OUT(0, 15);
        WAIT(15);
        var0 = MODEL_PLAYER();
        MODEL_POS(var0, SEARCH_ID("01pos_07"));
        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        FADE_IN(0, 15);
        WAIT(15);
        COMM_217(82);
        MODEL_POS(MODEL_DSP(2, 20), SEARCH_ID("01pos_07"));
        MODEL_MOTION2(var0, 12, 3, 15, 3);
        WAIT(80);
        FLD_BGM_FADE();
        CALL_NEXT(1, 21, 748);
        CALL_EVENT(748);
        return;
    }
}

