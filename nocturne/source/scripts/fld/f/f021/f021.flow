void 006_01npc_03()
{
    while (1)
    {
        if (ACT_WIN_DSP(1))
        {
            PAD_DISABLE();
            SET_ALLPANEL(6);
            itfMesMngOpenWindow();
            if (BIT_CHK(115))
            {
                itfMesMngMessage(48) /* F21_AREA6_NPC3_SIJIMABUI: Commander Hikawa's god is finally here. */;
            }
            else if (BIT_CHK(1290))
            {
                itfMesMngMessage(47) /* F21_AREA6_NPC3_2ND: Commander Hikawa's god will soon descend upon us. */;
            }
            else
            {
                itfMesMngMessage(43) /* F21_AREA6_NPC3: Dang! You're pretty tough makin' it through that tunnel! */;
                if (itfMesMngSelect(44) /* F21_AREA6_NPC3_SEL: Yes. / No. */ == 0)
                {
                    itfMesMngMessage(45) /* F21_AREA6_NPC3_YES: You are, eh? */;
                    POINT_ADD(3, 4);
                }
                else
                {
                    itfMesMngMessage(46) /* F21_AREA6_NPC3_NO: Then, Commander Hikawa really will make you... *gulp* */;
                }
                BIT_ON(1290);
            }
            itfMesMngCloseWindow();
            SET_ALLPANEL(7);
            PAD_ENABLE();
        }
        SYNC();
    }
}

void 007_01npc_01()
{
    while (1)
    {
        if (ACT_WIN_DSP(1))
