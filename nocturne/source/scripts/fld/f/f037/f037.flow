void 019_start()
{
    if (BIT_CHK(1632) == 0)
    {
        FLD_MODEL_OFF(0, 19, "md_hoji_01", 0);
        FLD_MODEL_OFF(0, 19, "md_hoji_02", 0);
        FLD_MODEL_OFF(0, 19, "md_hoji_03", 0);
        FLD_MODEL_OFF(0, 19, "md_hoji_04", 0);
        FLD_MODEL_OFF(0, 19, "md_hoji_05", 0);
        FLD_MODEL_OFF(0, 19, "md_hoji_06", 0);
        FLD_MODEL_OFF(0, 19, "md_hoji_07", 0);
        FLD_MODEL_OFF(0, 19, "md_hoji_08", 0);
        FLD_MODEL_OFF(0, 19, "md_hoji_09", 0);
        FLD_MODEL_OFF(0, 19, "md_hoji_10", 0);
        FLD_MODEL_OFF(0, 19, "md_hoji_11", 0);
        FLD_MODEL_OFF(0, 19, "md_hoji_12", 0);
        BIT_ON(1632);
    }
}

