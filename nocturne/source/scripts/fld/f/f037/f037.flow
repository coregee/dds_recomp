            itfMesMngOpenWindow();
            if (BIT_CHK(1642))
            {
                itfMesMngMessage(23) /* MAGATAMA_DONE: > A stone is already inserted. */;
            }
            else if (BIT_CHK(132) && BIT_CHK(1645) == 0 || BIT_CHK(116) && BIT_CHK(1644) == 0 || BIT_CHK(97) && BIT_CHK(1643) == 0)
            {
                FADE_OUT(0, 15);
                WAIT(15);
                CAM_SEL_FOVY(SEARCH_ID("01cam_03"));
                var0 = MODEL_PLAYER();
                MODEL_POS(var0, SEARCH_ID("01pos_04"));
                FADE_IN(0, 15);
                WAIT(15);
                itfMesMngMessage(22) /* MAGATAMA_HONO: > There is an altar. */;
                itfMesMngMessage(24) /* SAIDAN01: > Which stone will you offer? */;
                if (BIT_CHK(116) == 0 || BIT_CHK(1644))
                {
                    local107 = local107 + 1;
                }
                if (BIT_CHK(97) == 0 || BIT_CHK(1643))
                {
                    local107 = local107 + 2;
                }
                if (BIT_CHK(132) == 0 || BIT_CHK(1645))
                {
                    local107 = local107 + 4;
                }
                itfMesMngMaskSelect(local107);
                local108 = itfMesMngSelect(25) /* SAIDAN01_SEL: Earthstone. / Netherstone. / Heavenstone. / None. */;
                if (local108 != 3)
                {
                    itfMesMngCloseWindow();
                    BIT_ON(1642);
                    WAIT(15);
                    MODEL_MOTION2(var0, 16, 10, 10, 3);
                    MODEL_WAIT(var0);
                    FLD_SE_PLAY(97);
                    FLD_MODEL_ON(0, 0, "md_hoji_02", 2);
                    WAIT(45);
                    FADE_OUT(1, 5);
                    WAIT(5);
                    FADE_IN(1, 5);
                    WAIT(5);
                    FADE_OUT(1, 5);
                    WAIT(20);
                    FADE_IN(1, 20);
                    WAIT(20);
                    itfMesMngOpenWindow();
                    if (local108 == 0)
                    {
                        itfMesMngMessage(26) /* SAIDAN01_SIJIMA: > You offered the Earthstone. */;
                        BIT_ON(1644);
                        BIT_OFF(991);
                    }
                    else if (local108 == 1)
                    {
                        itfMesMngMessage(27) /* SAIDAN01_MUSUBI: > You offered the Netherstone. */;
                        BIT_ON(1643);
                        BIT_OFF(992);
                    }
                    else
                    {
                        itfMesMngMessage(28) /* SAIDAN01_YOSUGA: > You offered the Heavenstone. */;
                        BIT_ON(1645);
                        BIT_OFF(990);
                    }
                    itfMesMngCloseWindow();
                    WAIT(15);
                    CAM_SEL_FOVY(SEARCH_ID("01cam_06"));
                    WAIT(30);
                    FLD_SE_PLAY(98);
                    FLD_MODEL_ON(0, 0, "md_hoji_05", 2);
                    WAIT(100);
                    if (BIT_CHK(1645) && BIT_CHK(1644) && BIT_CHK(1643))
                    {
                        BIT_ON(1646);
                        CAM_PATH_MOVE(SEARCH_ID("01cam_06"), SEARCH_ID("01cam_06_MOTION"));
                        CAM_PATH_WAIT(SEARCH_ID("01cam_06"));
                        FLD_SE_PLAY(99);
                        FLD_MODEL_ON(0, 0, "md_hoji_08", 2);
                        itfMesMngOpenWindow();
                        itfMesMngMessage(31) /* GO_KAGUTUTI: You have proven yourself worthy. Come to me. */;
                        itfMesMngCloseWindow();
                        FLD_MODEL_OFF(0, 0, "md_hoji_08", 2);
                        WAIT(30);
                        FADE_OUT(1, 30);
                        WAIT(30);
                        SET_CHASE_CAMERA();
                        CAM_SEL(- 1);
                        FADE_IN(1, 30);
                        WAIT(30);
                        SET_ALLPANEL(3);
                        PAD_ENABLE();
                        return;
                    }
                    FADE_OUT(0, 15);
                    WAIT(15);
                    SET_CHASE_CAMERA();
                    CAM_SEL(- 1);
                    FADE_IN(0, 15);
                    WAIT(15);
                }
                else
                {
                    itfMesMngCloseWindow();
                    FADE_OUT(0, 15);
                    WAIT(15);
                    SET_CHASE_CAMERA();
                    CAM_SEL(- 1);
                    FADE_IN(0, 15);
                    WAIT(15);
                }
            }
            else
            {
                itfMesMngMessage(20) /* NO_MAGATAMA: > There is an altar. */;
            }
            itfMesMngCloseWindow();
            SET_ALLPANEL(3);
            PAD_ENABLE();
            return;
        }
        SYNC();
    }
