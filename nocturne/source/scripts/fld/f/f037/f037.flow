void test()
{
    while (1)
    {
        if (ACT_WIN_DSP3(5) == 1)
        {
            PAD_DISABLE();
            itfMesMngOpenWindow();
            itfMesMngMessage(0) /* f037_MES01: There's an NPC in the other room. */;
            if (itfMesMngSelect(1) /* f037_MES01_SEL: Erase. / Add. */)
            {
                FLD_NPC_ON(0, 20, "npc_hoji_01");
            }
            else
            {
                FLD_NPC_OFF(0, 20, "npc_hoji_01");
            }
            itfMesMngCloseWindow();
            PAD_ENABLE();
        }
        SYNC();
    }
}

void 007_start()
{
    if (BIT_CHK(1652) == 0)
    {
        PAD_DISABLE();
        SET_ALLPANEL(4);
        itfMesMngOpenWindow();
        itfMesMngMessage(2) /* THOR00: > You can sense a strong power from the end of the hall. */;
        itfMesMngCloseWindow();
        BIT_ON(1652);
        SET_ALLPANEL(7);
        PAD_ENABLE();
    }
}

void 007_01eve_05()
{
    if (BIT_CHK(1649) == 0)
    {
        PAD_DISABLE();
        SET_ALLPANEL(2);
        FLD_BGM_FADE();
        FLD_BGM_PLAY(128);
        FADE_OUT(0, 15);
        WAIT(15);
        local94 = MODEL_DSP(3, 11);
        local93 = EFFBED_LOAD("/fld/f/bin/DEVILGEN.BED");
        CAM_SEL_FOVY(SEARCH_ID("01cam_04"));
        var0 = MODEL_PLAYER();
        MODEL_POS(var0, SEARCH_ID("01pos_26"));
        FADE_IN(0, 15);
        WAIT(15);
        QUAKE_ON(0, 50);
        PAD_ACT(1, 70, 300);
        WAIT(60);
        COMM_217(0);
        EFFECT_POS(local93, SEARCH_ID("01pos_24"));
        EFFBED_START(local93, 0);
        WAIT(10);
        MODEL_A(local94, 0, 0.0f);
        MODEL_POS(local94, SEARCH_ID("01pos_24"));
        FLD_MODEL_LIGHT(local94);
        MODEL_A(local94, 15, 1.0f);
        QUAKE_ON(10, 500);
        PAD_ACT(1, 170, 10);
        PAD_ACT(0, 1, 10);
        WAIT(90);
        itfMesMngOpenWindow();
        itfMesMngMessage(3) /* THOR01: I didn't imagine that we would meet here... */;
        itfMesMngMessage(4) /* THOR02: Neither did I imagine that you would become this strong... */;
        itfMesMngCloseWindow();
        CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
        itfMesMngOpenWindow();
        itfMesMngMessage(5) /* THOR03: ...I am Thor. Our paths have not crossed since the fall of the Mantra. */;
        itfMesMngCloseWindow();
        FADE_OUT(0, 15);
        WAIT(15);
        if (BIT_CHK(145))
        {
            CAM_SEL_FOVY(SEARCH_ID("01cam_05"));
            FADE_IN(0, 15);
            WAIT(15);
            itfMesMngOpenWindow();
            itfMesMngMessage(6) /* THOR_YOSUGA01: ...It seems that you are a follower of Yosuga. */;
            itfMesMngCloseWindow();
            CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
            MODEL_MOTION2(local94, 1, 0, 0, 1);
            itfMesMngOpenWindow();
            itfMesMngMessage(7) /* THOR_YOSUGA02: But, our battle is still unfinished. */;
            itfMesMngCloseWindow();
            CAM_PATH_MOVE(SEARCH_ID("01cam_02"), SEARCH_ID("01cam_02_MOTION"));
            WAIT(7);
            BIT_ON(1649);
            BIT_ON(2313);
            CALL_NEXT(1, 37, 500);
            CALL_BATTLE(1008);
            return;
        }
        else
        {
            CAM_SEL_FOVY(SEARCH_ID("01cam_05"));
            FADE_IN(0, 15);
            WAIT(15);
            itfMesMngOpenWindow();
            itfMesMngMessage(11) /* THOR_NO_YOSUGA01: ...It seems that you and I have different objectives in climbing this... */;
            itfMesMngCloseWindow();
            CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
            MODEL_MOTION2(local94, 1, 0, 0, 1);
            itfMesMngOpenWindow();
            itfMesMngMessage(12) /* THOR_NO_YOSUGA02: The world of Yosuga shall be built upon your lifeless body! */;
            itfMesMngCloseWindow();
            CAM_PATH_MOVE(SEARCH_ID("01cam_02"), SEARCH_ID("01cam_02_MOTION"));
            WAIT(7);
            BIT_ON(1649);
            BIT_ON(2313);
            CALL_NEXT(1, 37, 500);
            CALL_BATTLE(1008);
            return;
        }
    }
}

void 007_THOR_AFTER()
{
    PAD_DISABLE();
    SET_ALLPANEL(0);
    CAM_SEL_FOVY(SEARCH_ID("01cam_01"));
    local95 = MODEL_DSP(6, 302);
    MODEL_POS(local95, SEARCH_ID("01pos_22"));
    FLD_MODEL_LIGHT(local95);
    MODEL_MOTION2(local95, 2, 3, 15, 1);
    WAIT(15);
    DIST_BLUR_PARA(10, 50, 10, 0.225f, 0.005f, 0.13f, 0);
    DIST_BLUR_RGBA(200, 128, 128, 128);
    DIST_BLUR_AREA(40, 0, 0);
    DIST_BLUR_ON(15);
    itfMesMngOpenWindow();
    DIST_BLUR_OFF(45);
    if (BIT_CHK(145))
    {
        itfMesMngMessage(8) /* THOR_YOSUGA03: ...Well... done. */;
    }
    else
    {
        itfMesMngMessage(13) /* THOR_NO_YOSUGA03: How can this be!? */;
    }
    if (BIT_CHK(145))
    {
        itfMesMngMessage(9) /* THOR_YOSUGA04: Farewell. I hereby pledge to lend you my power... */;
    }
    else
    {
        itfMesMngMessage(14) /* THOR_NO_YOSUGA04: ...Even so! */;
    }
    DIST_BLUR_OFF(0);
    MODEL_MOTION2(local95, 4, 3, 15, 3);
    WAIT(15);
    COMM_217(76);
    CAM_PATH_MOVE(SEARCH_ID("01cam_01"), SEARCH_ID("01cam_01_MOTION"));
    DIST_BLUR_PARA(10, 50, 10, 0.225f, 0.005f, 0.13f, 0);
    DIST_BLUR_RGBA(200, 128, 128, 128);
    DIST_BLUR_AREA(128, 0, 0);
    DIST_BLUR_ON(15);
    if (BIT_CHK(145))
    {
        itfMesMngMessage(10) /* THOR_YOSUGA05: Gaaaaaaaaaaaaaahhhhh......!! */;
    }
    else
    {
        itfMesMngMessage(15) /* THOR_NO_YOSUGA05: Gaaaaaaaaaaaaaahhhhh......!! */;
    }
    WAIT(10);
    itfMesMngCloseWindow();
    FADE_OUT(1, 30);
    MODEL_A(local95, 30, 0.0f);
    WAIT(30);
    FADE_IN(1, 30);
    WAIT(30);
    MODEL_CLS(local95);
    DIST_BLUR_OFF(45);
    WAIT(45);
    itfMesMngOpenWindow();
    itfMesMngMessage(16) /* THOR04: > You defeated Thor. */;
    itfMesMngCloseWindow();
    FADE_OUT(0, 30);
    WAIT(30);
    SET_CHASE_CAMERA();
    CAM_SEL(- 1);
    FADE_IN(0, 15);
    WAIT(15);
    SET_ALLPANEL(3);
    PAD_ENABLE();
}

