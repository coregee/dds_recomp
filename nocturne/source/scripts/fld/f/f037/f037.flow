{
    if (DIR_HIT_CNTR(0) == 1)
    {
        FLD_MAP_ON(0, 0, 2);
        FLD_MODEL_ON(0, 0, "md_hoji_01", 1);
        FLD_ATARI_OFF(0, 0, "atari_hoji_01");
