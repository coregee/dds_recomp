    while (1)
    {
        if (ACT_WIN_DSP3(5) == 1)
        {
            PAD_DISABLE();
            FADE_OUT(0, 10);
            WAIT(10);
            CAM_SEL_FOVY(SEARCH_ID("01cam_06"));
            MODEL_POS(MODEL_PLAYER(), SEARCH_ID("01pos_19"));
            FADE_IN(0, 5);
            local40 = SEARCH_ID("01all_02");
            FLD_SE_PLAY(96);
            OBJ_PATH_MOVE(local40, SEARCH_ID("01path_02"), 0);
            CAM_PATH_MOVE(SEARCH_ID("01cam_06"), SEARCH_ID("01cam_06_MOTION"));
            WAIT(70);
            FADE_OUT(0, 30);
            WAIT(30);
            FLD_SE_STOP(96);
            FLD_CALL_WAPEX(48);
            return;
        }
        SYNC();
    }
}

void 006_gimick_rst()
{
    FLD_GIMIC_HOJI(32, 15, 0, 0);
    FLD_GIMIC_HOJI(32, 18, 1, 1);
    FLD_GIMIC_HOJI(32, 18, 3, 1);
    FLD_GIMIC_HOJI(32, 18, 4, 0);
    FLD_GIMIC_HOJI(32, 18, 6, 1);
}

