                        BIT_OFF(991);
                    }
                    else if (local114 == 1)
                    {
                        itfMesMngMessage(27) /* SAIDAN01_MUSUBI: > You offered the Netherstone. */;
                        BIT_ON(1643);
                        BIT_OFF(992);
                    }
                    else
                    {
                        itfMesMngMessage(28) /* SAIDAN01_YOSUGA: > You offered the Heavenstone. */;
                        BIT_ON(1645);
                        BIT_OFF(990);
                    }
                    itfMesMngCloseWindow();
                    WAIT(15);
                    CAM_SEL_FOVY(SEARCH_ID("01cam_06"));
                    WAIT(30);
                    FLD_SE_PLAY(98);
                    FLD_MODEL_ON(0, 0, "md_hoji_07", 2);
                    WAIT(100);
                    if (BIT_CHK(1645) && BIT_CHK(1644) && BIT_CHK(1643))
                    {
                        BIT_ON(1646);
                        CAM_PATH_MOVE(SEARCH_ID("01cam_06"), SEARCH_ID("01cam_06_MOTION"));
                        CAM_PATH_WAIT(SEARCH_ID("01cam_06"));
                        FLD_SE_PLAY(99);
                        FLD_MODEL_ON(0, 0, "md_hoji_08", 2);
                        itfMesMngOpenWindow();
                        itfMesMngMessage(31) /* GO_KAGUTUTI: You have proven yourself worthy. Come to me. */;
                        itfMesMngCloseWindow();
                        FLD_MODEL_OFF(0, 0, "md_hoji_08", 2);
                        WAIT(30);
                        FADE_OUT(1, 30);
                        WAIT(30);
                        SET_CHASE_CAMERA();
                        CAM_SEL(- 1);
                        FADE_IN(1, 30);
                        WAIT(30);
                        SET_ALLPANEL(3);
                        PAD_ENABLE();
                        return;
                    }
                    FADE_OUT(0, 15);
                    WAIT(15);
                    SET_CHASE_CAMERA();
                    CAM_SEL(- 1);
                    FADE_IN(0, 15);
                    WAIT(15);
                }
                else
                {
                    itfMesMngCloseWindow();
                    FADE_OUT(0, 15);
                    WAIT(15);
                    SET_CHASE_CAMERA();
                    CAM_SEL(- 1);
                    FADE_IN(0, 15);
                    WAIT(15);
                }
            }
            else
            {
                itfMesMngMessage(20) /* NO_MAGATAMA: > There is an altar. */;
            }
            itfMesMngCloseWindow();
            SET_ALLPANEL(3);
            PAD_ENABLE();
            return;
        }
        SYNC();
    }
}

void 027_01eve_07()
{
    if (BIT_CHK(1646))
    {
        while (1)
        {
            if (ACT_WIN_DSP3(5))
            {
                PAD_DISABLE();
                SET_ALLPANEL(6);
                itfMesMngOpenWindow();
                itfMesMngMessage(32) /* SAIDAN_LAST: > Will you go to Kagutsuchi? */;
                local116 = itfMesMngSelect(33) /* SAIDAN_LAST_SEL: Yes. / No. */;
                if (local116 == 0)
                {
                    FADE_OUT(0, 15);
                    WAIT(15);
                    FLD_BGM_FADE();
                    CALL_NEXT(1, 0, 0);
                    CALL_EVENT(705);
                    return;
                }
                itfMesMngCloseWindow();
                SET_ALLPANEL(7);
                PAD_ENABLE();
            }
            SYNC();
        }
    }
}

