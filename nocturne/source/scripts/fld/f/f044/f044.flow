void 009_01npc_02()
{
    while (1)
    {
        if (ACT_WIN_DSP(1))
        {
            PAD_DISABLE();
            SET_NPC_CAMERA("01npc_02");
            SET_ALLPANEL(6);
            FLD_BGM_FADE();
            FLD_BGM_PLAY(136);
            local54 = prm_PLAYER_GET_LEVEL();
            if (local54 > 59)
            {
                WAIT(1);
                if (BIT_CHK(312) == 0)
                {
                    WAIT(1);
                    if (prm_STOCK_FULL_CHECK() == 0)
                    {
                        local55 = 50000;
                        itfMesMngOpenWindow();
                        itfMesMngMessage(165) /* F041_SINEN_LEV001: ...You're pretty strong. */;
                        if (prm_DV_CHECK(122) == 0)
                        {
                            itfMesMngMessage(168) /* F041_SINEN_LEV003: Here's what I'm selling... */;
                            if (itfMesMngSelect(170) /* F041_SINEN_LEV003_SEL: Alright, I'll buy it. / No thanks. */ == 0)
                            {
                                local55 = 50000;
                                if (prm_MAKA_CHECK(local55) == 0)
                                {
                                    itfMesMngMessage(176) /* F041_SINEN_KANE: Hey hey hey, you don't have enough Macca. */;
                                    itfMesMngCloseWindow();
                                    goto END;
                                }
                                else
                                {
                                    itfMesMngMessage(171) /* F041_SINEN_LEV004: Excellent choice! */;
                                    itfMesMngMessage(172) /* F041_SINEN_LEV005: > You purchased a demon from the Shady Broker. */;
                                    itfMesMngCloseWindow();
                                    prm_DV_PLUS(122, 2, 0);
                                    prm_DV_COPY_PARAM(122, 212);
                                    BIT_ON(312);
                                    COMM_139(-local55);
                                    goto END;
                                }
                                WAIT(1);
                            }
                            itfMesMngMessage(175) /* F041_SINEN_LEVIRANAI: That's fine. If you change your mind, feel free to come back anytime. */;
                            itfMesMngCloseWindow();
                            goto END;
                            WAIT(1);
                        }
                        WAIT(1);
                        itfMesMngOpenWindow();
                        itfMesMngMessage(166) /* F041_SINEN_DAM: ...On second thought, forget what I just said. */;
                        itfMesMngCloseWindow();
                        goto END;
                    }
                    itfMesMngOpenWindow();
                    itfMesMngMessage(167) /* F041_SINEN_LEV002: ...You're pretty strong. */;
                    itfMesMngCloseWindow();
                    goto END;
                }
                WAIT(1);
            }
            if (BIT_CHK(312) == 0)
            {
                itfMesMngOpenWindow();
                itfMesMngMessage(163) /* F041_SINEN_X: ...I'm glad you made it here. */;
                itfMesMngCloseWindow();
            }
            else
            {
                itfMesMngOpenWindow();
                itfMesMngMessage(164) /* F041_SINEN_X2: ...I've got nothing else to sell you. ...Hey, don't worry. */;
                itfMesMngCloseWindow();
            }
        END:
            FLD_BGM_FADE();
            FLD_BGM_PLAY(1);
            SET_ALLPANEL(7);
            SET_CHASE_CAMERA();
            PAD_ENABLE();
        }
        SYNC();
    }
}

