                    WAIT(15);
                    MODEL_ON(var0);
                    MODEL_SHADOW_ON(var0);
                    CAM_SEL(- 1);
                    FADE_IN(0, 15);
                    WAIT(15);
                    PAD_ENABLE();
                    return;
                }
                if (prm_BOSS_PRESS_REC(267, 0) < 999)
                {
                    if (var250 <= var251)
                    {
                        itfMesMngMessage(39) /* SPEC_BEST_SCORE_R: > "Record of Specter: Defeated in {var 0} turn(s)." */;
                    }
                    else
                    {
                        itfMesMngMessage(38) /* SPEC_BEST_SCORE: > "Record of Specter: Defeated in {var 0} turn(s)." */;
