void 029_01npc_01()
{
    while (1)
    {
        if (ACT_WIN_DSP(1))
        {
            PAD_DISABLE();
            SET_NPC_CAMERA("01npc_01");
            SET_ALLPANEL(6);
            FLD_BGM_FADE();
            FLD_BGM_PLAY(130);
            itfMesMngOpenWindow();
            itfMesMngMessage(90) /* BOTTAKURI_01: Gee, you look worn out. */;
            if (itfMesMngSelect(0) /* YN_SEL: Yes. / No. */)
            {
                itfMesMngMessage(91) /* BOTTAKURI_NO: Oh... Well, please come again! */;
            }
            else
            {
                if (prm_MAKA_CHECK(500) == 0)
                {
                    itfMesMngMessage(92) /* BOTTAKURI_NOMONEY: Oh, you don't have enough Macca... Come back when you do. */;
                }
                else
                {
                    COMM_139(- 500);
                    itfMesMngMessage(93) /* BOTTAKURI_YES_01: You must be thirsty. Here, have a drink... */;
                    prm_PARTY_KAIFUKU();
                    itfMesMngMessage(94) /* BOTTAKURI_YES_02: > Your party recovered. */;
                    itfMesMngMessage(95) /* BOTTAKURI_YES_03: Go ahead, have some more... */;
                    DIST_BLUR_PARA(60, 96, 15, 0.222f, 0.005f, 0.13f, 0);
                    DIST_BLUR_RGBA(132, 132, 132, 101);
                    DIST_BLUR_AREA(256, 0, 0);
                    DIST_BLUR_ON(30);
                    itfMesMngMessage(96) /* BOTTAKURI_YES_04: Are you feeling better? Here's some more... */;
                    prm_PARTY_KAIFUKU();
                    WAIT(10);
                    prm_PARTY_KAIFUKU();
                    itfMesMngMessage(97) /* BOTTAKURI_YES_05: > Your party recovered some more. */;
                    DIST_BLUR_PARA(60, 176, 15, 0.222f, 0.005f, 0.13f, 0);
                    DIST_BLUR_RGBA(132, 132, 132, 101);
                    DIST_BLUR_AREA(256, 0, 0);
                    COMM_128(30);
                    WAIT(30);
                    itfMesMngMessage(98) /* BOTTAKURI_YES_06: ...Have... another... drink... */;
                    WAIT(30);
                    itfMesMngMessage(98) /* BOTTAKURI_YES_06: ...Have... another... drink... */;
                    COMM_139(- 10000);
                    FADE_OUT(1, 30);
                    WAIT(30);
                    itfMesMngCloseWindow();
                    DIST_BLUR_OFF(0);
                    CAM_SEL(SEARCH_ID("01cam_03"));
                    FADE_IN(0, 10);
                    WAIT(10);
                    itfMesMngOpenWindow();
                    itfMesMngMessage(99) /* BOTTAKURI_YES_07: > Your wallet feels really light... */;
                    itfMesMngCloseWindow();
                    FADE_OUT(0, 30);
                    WAIT(30);
                    FLD_BGM_FADE();
                    FLD_CALL_WAPEX(100);
                    return;
                }
            }
            itfMesMngCloseWindow();
            FLD_BGM_FADE();
            FLD_BGM_PLAY(1);
            SET_ALLPANEL(7);
            SET_CHASE_CAMERA();
            PAD_ENABLE();
        }
        SYNC();
    }
}

