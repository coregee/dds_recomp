            itfMesMngCloseWindow();
            local42 = itfMesMngSelect(5) /* F044_DEBBUG3_SEL: Black Visor flag on / Aciel flag on / Skadi flag on / Albion flag on... */;
            if (local42 == 0)
            {
                BIT_ON(1006);
            }
            else if (local42 == 1)
            {
                BIT_ON(1705);
            }
            else if (local42 == 2)
            {
                BIT_ON(1706);
            }
            else if (local42 == 3)
            {
                BIT_ON(1707);
            }
            else if (local42 == 4)
            {
                BIT_ON(1006);
                BIT_ON(1705);
                BIT_ON(1706);
                BIT_ON(1707);
            }
            PAD_ENABLE();
        }
        SYNC();
    }
}

