                {
                    itfMesMngCloseWindow();
                    FADE_OUT(0, 15);
                    WAIT(15);
                    MODEL_ON(var0);
                    MODEL_SHADOW_ON(var0);
                    CAM_SEL(- 1);
                    FADE_IN(0, 15);
                    WAIT(15);
                    PAD_ENABLE();
                    return;
                }
            }
            BIT_ON(2588);
            itfMesMngMessage(35) /* VISER_USE: > Will you put on the Black Visor? */;
            if (itfMesMngSelect(0) /* YN_SEL: Yes. / No. */)
            {
                itfMesMngCloseWindow();
                FADE_OUT(0, 15);
                WAIT(15);
                MODEL_ON(var0);
                MODEL_SHADOW_ON(var0);
                CAM_SEL(- 1);
                FADE_IN(0, 15);
                WAIT(15);
                PAD_ENABLE();
                return;
            }
            itfMesMngMessage(41) /* SPEC_REMEMBER: > You recall the battle against Specter... */;
            itfMesMngCloseWindow();
