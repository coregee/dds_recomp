        FLD_TITLE_START(11);
        BIT_ON(1087);
        WAIT(120);
        FADE_OUT(0, 30);
        WAIT(30);
        CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
        FLD_MODEL_OFF(0, 0, "md_hoji_01", 0);
        FLD_MODEL_ON(0, 0, "md_hoji_02", 0);
        FADE_IN(0, 45);
        MODEL_WAIT(local36);
        MODEL_MOTION2(local36, 8, 3, 3, 1);
        FLD_SE_PLAY(99);
        WAIT(15);
        FLD_SE_STOP(99);
        MODEL_MOTION2(local36, 11, 10, 10, 3);
        MODEL_WAIT(local36);
        MODEL_MOTION2(local36, 12, 0, 0, 1);
        WAIT(20);
        CAM_SEL_FOVY(SEARCH_ID("01cam_04"));
        itfMesMngOpenWindow();
        itfMesMngMessage(2) /* MAIL: > You received a message. */;
        itfMesMngMessage(3) /* MAIL2: You're late... You're way late, {firstname 0} {lastname 0}! */;
        itfMesMngMessage(4) /* MAIL3: > It's from your classmate. */;
        itfMesMngCloseWindow();
        FADE_OUT(0, 15);
        WAIT(15);
        nmeNameEntry(2, 1);
        CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
        FADE_IN(0, 15);
        WAIT(15);
        itfMesMngOpenWindow();
        itfMesMngMessage(5) /* MAIL4: I don't care if you come or not, but Ms. {lastname 1}'s nice to me wh... */;
        itfMesMngCloseWindow();
        MODEL_MOTION2(local36, 10, 0, 0, 2);
        MODEL_WAIT(local36);
        FADE_OUT(0, 30);
        WAIT(30);
        SET_CHASE_CAMERA();
        CAM_SEL_FOVY(- 1);
        FADE_IN(0, 30);
        WAIT(30);
        SET_ALLPANEL(3);
        PAD_ENABLE();
        ENCOUNT_ON();
    }
}

void 001_01eve_03()
{
    while (1)
    {
        if (DIR_HIT_CNTR(0) == 1)
        {
            if (ACT_WIN_DSP(9) == 1)
            {
                if (BIT_CHK(1086) == 0)
                {
                    PAD_DISABLE();
                    SET_ALLPANEL(6);
                    itfMesMngOpenWindow();
                    itfMesMngMessage(6) /* JIHAN: > You see a vending machine! */;
                    local37 = itfMesMngSelect(7) /* STOKERE_SEL: Yes. / No. */;
                    if (local37 == 0)
                    {
                        var0 = MODEL_PLAYER();
                        MODEL_MOTION2(var0, 16, 4, 20, 0);
                        MODEL_WAIT(var0);
                        FLD_SE_PLAY(96);
                        WAIT(60);
                        itfMesMngMessage(8) /* STOKERE_YES: > The drink that came out isn't any of the ones listed. */;
                        BIT_ON(1086);
                        prm_ITEM_PLUS(15, 1);
                    }
                    else
                    {
                        itfMesMngMessage(9) /* STOKERE_NO: > You decided to hurry on ahead. */;
                    }
                    itfMesMngCloseWindow();
                    SET_ALLPANEL(7);
                    PAD_ENABLE();
                    return;
                }
                else
                {
                    PAD_DISABLE();
                    SET_ALLPANEL(6);
                    itfMesMngOpenWindow();
                    itfMesMngMessage(10) /* URIKIRE: > The vending machine is sold out. */;
                    itfMesMngCloseWindow();
                    SET_ALLPANEL(7);
                    PAD_ENABLE();
                    return;
                }
            }
        }
        SYNC();
    }
}

