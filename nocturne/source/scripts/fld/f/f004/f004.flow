        PAD_ENABLE();
    }
}

void 001_01eve_03()
{
    if (BIT_CHK(266) == 0 && BIT_CHK(1876) == 0)
    {
        PAD_DISABLE();
        SET_ALLPANEL(2);
        itfMesMngOpenWindow();
        itfMesMngMessage(5) /* KEHAI */;
        if (itfMesMngSelect(6) == 0)
        {
            itfMesMngMessage(7) /* KEHAI2 */;
            if (itfMesMngSelect(6) == 0)
            {
                itfMesMngCloseWindow();
                FLD_BGM_FADE();
                FADE_OUT(1, 15);
                WAIT(15);
                CALL_NEXT(1, 4, 741);
                CALL_EVENT(741);
                return;
            }
        }
        itfMesMngMessage(8) /* TRY_RUNAWAY */;
        if (GET_MOON16() == 8)
        {
            itfMesMngMessage(10) /* SIPPAI */;
            itfMesMngMessage(12) /* SIPPAI_KOTEN */;
        }
        else if (RND(100) > 60)
        {
            itfMesMngMessage(10) /* SIPPAI */;
            itfMesMngMessage(11) /* SIPPAI2 */;
        }
        else
        {
            itfMesMngMessage(9) /* RUNAWAY */;
            itfMesMngCloseWindow();
            SET_ALLPANEL(3);
            BIT_ON(1876);
            PAD_ENABLE();
            return;
        }
        itfMesMngCloseWindow();
        FLD_BGM_FADE();
        FADE_OUT(1, 15);
        WAIT(15);
        CALL_NEXT(1, 4, 741);
        CALL_EVENT(741);
        return;
    }
}

void 001_01eve_04()
{
    if (BIT_CHK(266) == 0 && BIT_CHK(1887) == 0 && BIT_CHK(1876) == 0)
    {
        PAD_DISABLE();
        SET_ALLPANEL(0);
        itfMesMngOpenWindow();
        itfMesMngMessage(4) /* FIRE_YURE */;
        itfMesMngCloseWindow();
        BIT_OFF(1876);
        BIT_ON(1887);
        SET_ALLPANEL(3);
        PAD_ENABLE();
    }
}

void 001_01eve_05()
{
    BIT_OFF(1887);
    BIT_OFF(1876);
}

