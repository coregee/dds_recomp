        if (itfMesMngSelect(45) /* F26_ONGYO_SEL: I sliced and diced them. / Must be some other guy. */ == 0)
        {
            CAM_SEL_FOVY(SEARCH_ID("01cam_03"));
            itfMesMngMessage(47) /* F26_ONGYO_YES: Insolent fool!!!! */;
        }
        else
        {
            CAM_SEL_FOVY(SEARCH_ID("01cam_03"));
            itfMesMngMessage(46) /* F26_ONGYO_NO: You cannot fool me!! */;
        }
        itfMesMngMessage(48) /* F26_ONGYO_YES2: Learn your weakness through my illusions! */;
        itfMesMngCloseWindow();
        MODEL_MOTION2(local37, 14, 10, 10, 2);
        WAIT(10);
        COMM_217(35);
        WAIT(40);
        BIT_ON(1446);
        BIT_ON(2321);
        BIT_OFF(1449);
        CALL_NEXT(1, 26, 503);
        CALL_BATTLE(199);
        return;
    }
    PAD_ENABLE();
}

void 017_goout()
{
    PAD_DISABLE();
    SET_ALLPANEL(6);
    FLD_BGM_FADE();
    FLD_BGM_PLAY(134);
    CAM_SEL_FOVY(SEARCH_ID("01cam_04"));
    itfMesMngOpenWindow();
    itfMesMngMessage(43) /* F26_FUIN_YOKI: > You sense a strong power from beyond the door... */;
    itfMesMngCloseWindow();
    SET_ALLPANEL(7);
    PAD_ENABLE();
}

void 017_01eve_03()
{
    if (BIT_CHK(1446) == 0)
    {
        PAD_DISABLE();
        CALL_FIELD2(11, "01pos_07");
        return;
    }
}

