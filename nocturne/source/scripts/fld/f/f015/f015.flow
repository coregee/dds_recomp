        itfMesMngCloseWindow();
        BIT_OFF(1879);
        SET_ALLPANEL(3);
        PAD_ENABLE();
    }
}

void 014_01eve_01()
{
    if (BIT_CHK(265) == 0 && BIT_CHK(1879) == 0 && BIT_CHK(1976) && BIT_CHK(62) && BIT_CHK(262))
    {
        PAD_DISABLE();
        SET_ALLPANEL(2);
        itfMesMngOpenWindow();
        itfMesMngMessage(111) /* KEHAI: > You can feel the presence of a terrifying demon... */;
        if (itfMesMngSelect(112) /* YES_NO_SEL: Yes. / No. */ == 0)
        {
            itfMesMngMessage(113) /* KEHAI2: > Are you sure? */;
            if (itfMesMngSelect(112) /* YES_NO_SEL: Yes. / No. */ == 0)
            {
                itfMesMngCloseWindow();
                FADE_OUT(0, 15);
                WAIT(15);
                var0 = MODEL_PLAYER();
                MODEL_POS(var0, SEARCH_ID("01pos_03"));
                FADE_IN(0, 15);
                WAIT(15);
                COMM_217(82);
                MODEL_POS(MODEL_DSP(2, 20), SEARCH_ID("01pos_03"));
                MODEL_MOTION2(var0, 12, 3, 15, 3);
                WAIT(80);
                FLD_BGM_FADE();
                CALL_NEXT(1, 15, 745);
                CALL_EVENT(745);
                return;
            }
        }
        itfMesMngMessage(114) /* TRY_RUNAWAY: > ............ */;
        if (GET_MOON16() == 8)
        {
            itfMesMngMessage(116) /* SIPPAI: > It looks like you won't be able to escape... */;
            itfMesMngMessage(118) /* SIPPAI_KOTEN: The flames of the Candelabrum burn passionately! You won't escape! */;
        }
        else if (RND(100) > 60)
        {
            itfMesMngMessage(116) /* SIPPAI: > It looks like you won't be able to escape... */;
        }
        else
        {
            itfMesMngMessage(115) /* RUNAWAY: > It looks like you'll be able to get away. */;
            itfMesMngCloseWindow();
            SET_ALLPANEL(3);
            BIT_ON(1879);
            PAD_ENABLE();
            return;
        }
        itfMesMngCloseWindow();
        FADE_OUT(0, 15);
        WAIT(15);
        var0 = MODEL_PLAYER();
        MODEL_POS(var0, SEARCH_ID("01pos_03"));
        FADE_IN(0, 15);
        WAIT(15);
        COMM_217(82);
        MODEL_POS(MODEL_DSP(2, 20), SEARCH_ID("01pos_03"));
        MODEL_MOTION2(var0, 12, 3, 15, 3);
        WAIT(80);
        FLD_BGM_FADE();
        CALL_NEXT(1, 15, 745);
        CALL_EVENT(745);
        return;
    }
}

