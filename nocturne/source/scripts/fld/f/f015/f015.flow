void 014_b_rider()
{
    if (BIT_CHK(265) == 0 && BIT_CHK(1976) && BIT_CHK(62) && BIT_CHK(262))
    {
        PAD_DISABLE();
        SET_ALLPANEL(0);
        DIST_BLUR_PARA(60, 166, 5, 0.062f, 0, 0.13f, 1);
        DIST_BLUR_RGBA(212, 102, 102, 31);
        DIST_BLUR_AREA(226, 0, 0);
        DIST_BLUR_ON(15);
