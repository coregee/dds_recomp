        CAM_PATH_WAIT(SEARCH_ID("01cam_11"));
        MODEL_MOTION2(local48, 2, 0, 20, 0);
        WAIT(20);
        FLD_MSE_PLAY2(81, 0);
        WAIT(25);
        FADE_OUT(0, 30);
        WAIT(30);
        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        WAIT(2);
        FLD_BGM_FADE();
        FLD_CALL_WAPEX(31);
        return;
    }
}

void 021_start()
{
    PAD_DISABLE();
    SET_ALLPANEL(0);
    FLD_BGM_FADE();
    if (BIT_CHK(115) == 0)
    {
        FLD_BGM_PLAY(133);
    }
    else
    {
        FLD_BGM_PLAY(132);
    }
    CAM_SEL_FOVY(SEARCH_ID("01cam_04"));
    local50 = SCR_RUN(63, 0);
    if (BIT_CHK(115) == 0)
    {
        FADE_IN(1, 15);
        WAIT(15);
    }
    if (BIT_CHK(115))
    {
        WAIT(90);
    }
    itfMesMngOpenWindow();
    if (BIT_CHK(115) == 0)
    {
        itfMesMngMessage(94) /* f015_LUS_VOL03: As you can see, Tokyo has now become a circular world. */;
        itfMesMngMessage(95) /* f015_LUS_VOL04: Now, do you see something shining in the center of this world? */;
        itfMesMngMessage(96) /* f015_LUS_VOL05: That is what created this Vortex World, */;
    }
    else
    {
        itfMesMngMessage(104) /* F034_KAGUTUCHI_01: The time has finally come. The way shall now be revealed... */;
        itfMesMngCloseWindow();
        WAIT(90);
        itfMesMngOpenWindow();
        itfMesMngMessage(105) /* F034_KAGUTUCHI_02: ...The Yahirono Himorogi that you possess... */;
        itfMesMngCloseWindow();
        WAIT(90);
        itfMesMngOpenWindow();
        itfMesMngMessage(106) /* F034_KAGUTUCHI_03: Fate awaits you within... */;
    }
    itfMesMngCloseWindow();
    WAIT(30);
    FADE_OUT(1, 30);
    WAIT(30);
    SCR_KILL(local50);
    if (BIT_CHK(115) == 0)
    {
        CALL_FIELD2(20, "01pos_05");
        return;
    }
    else
    {
        CALL_FIELD(34, 3, "01pos_11");
        return;
    }
    return;
}

