        local40 = MODEL_DSP(6, 63);
        local41 = MODEL_DSP(6, 65);
        local42 = EFFBED_LOAD("/fld/f/bin/DEVILGEN.BED");
        local43 = EFFBED_LOAD("/fld/f/bin/DEVILGEN.BED");
        FADE_IN(0, 30);
        WAIT(30);
        CAM_PATH_MOVE(SEARCH_ID("01cam_01"), SEARCH_ID("01cam_01_MOTION"));
        CAM_PATH_WAIT(SEARCH_ID("01cam_01"));
        WAIT(10);
        EFFECT_POS(local42, SEARCH_ID("01pos_03"));
        EFFECT_POS(local43, SEARCH_ID("01pos_05"));
        EFFBED_START(local42, 0);
        EFFBED_START(local43, 0);
        COMM_217(0);
        WAIT(10);
        MODEL_A(local40, 0, 0.0f);
        MODEL_A(local41, 0, 0.0f);
        MODEL_POS(local40, SEARCH_ID("01pos_03"));
        MODEL_POS(local41, SEARCH_ID("01pos_05"));
        FLD_MODEL_LIGHT(local40);
        FLD_MODEL_LIGHT(local41);
        MODEL_A(local40, 15, 1.0f);
        MODEL_A(local41, 15, 1.0f);
        QUAKE_ON(10, 300);
        PAD_ACT(1, 255, 15);
        PAD_ACT(0, 1, 15);
        WAIT(60);
        CAM_SEL_FOVY(SEARCH_ID("01cam_05"));
        WAIT(15);
        itfMesMngOpenWindow();
        itfMesMngMessage(30) /* devil_01 */;
        itfMesMngCloseWindow();
        CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
        WAIT(15);
        itfMesMngOpenWindow();
        itfMesMngMessage(31) /* devil_02 */;
        itfMesMngCloseWindow();
        CAM_SEL_FOVY(SEARCH_ID("01cam_03"));
        WAIT(15);
        itfMesMngOpenWindow();
        itfMesMngMessage(32) /* devil_03 */;
        itfMesMngMessage(33) /* devil_04 */;
        itfMesMngMessage(34) /* devil_05 */;
        if (itfMesMngSelect(35) == 0)
        {
            CAM_SEL_FOVY(SEARCH_ID("01cam_04"));
            MODEL_MOTION2(local40, 14, 3, 15, 0);
            WAIT(15);
            COMM_217(78);
            itfMesMngMessage(36) /* devil_06 */;
            itfMesMngCloseWindow();
            MODEL_WAIT(local40);
            WAIT(15);
            POINT_ADD(1, 8);
        }
        else
        {
            CAM_SEL_FOVY(SEARCH_ID("01cam_04"));
            MODEL_MOTION2(local40, 15, 3, 15, 0);
            WAIT(20);
            COMM_217(79);
            itfMesMngMessage(37) /* devil_07 */;
            itfMesMngCloseWindow();
            MODEL_WAIT(local40);
            WAIT(15);
        }
        CAM_SEL_FOVY(SEARCH_ID("01cam_06"));
        itfMesMngOpenWindow();
        itfMesMngMessage(38) /* devil_08 */;
        itfMesMngCloseWindow();
        WAIT(15);
        FLD_SE_PLAY(56);
        FADE_OUT(1, 5);
        WAIT(5);
        FADE_IN(1, 5);
        WAIT(5);
        FADE_OUT(1, 5);
        WAIT(5);
        MODEL_OFF(local40);
        MODEL_OFF(local41);
        MODEL_CLS(local40);
        MODEL_CLS(local41);
        FADE_IN(1, 5);
        WAIT(30);
        itfMesMngOpenWindow();
        itfMesMngMessage(39) /* devil_09 */;
        itfMesMngCloseWindow();
        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        SET_ALLPANEL(3);
        ENCOUNT_ON();
        PAD_ENABLE();
        return;
    }
}

void 008_01eve_02()
{
    while (1)
    {
        if (DIR_HIT_CNTR(0) == 1)
        {
            if (ACT_WIN_DSP(9) == 1)
            {
                PAD_DISABLE();
                itfMesMngSetVarScr(0, POINT_GET(2), 0);
                itfMesMngSetVarScr(1, POINT_GET(3), 0);
                itfMesMngSetVarScr(2, POINT_GET(1), 0);
                itfMesMngOpenWindow();
                itfMesMngMessage(40) /* TEST */;
                itfMesMngCloseWindow();
                PAD_ENABLE();
                return;
            }
        }
        SYNC();
    }
}

