void 013_01eve_51()
{
    if (BIT_CHK(1703) == 1)
    {
        while (1)
        {
            if (DIR_HIT_CNTR(0) == 1)
            {
                if (ACT_WIN_DSP(9) == 1)
                {
                    PAD_DISABLE();
                    itfMesMngOpenWindow();
                    itfMesMngMessage(4) /* WARP_NONE */;
                    itfMesMngCloseWindow();
                    PAD_ENABLE();
                    return;
                }
            }
            SYNC();
        }
    }
    else
    {
        PAD_DISABLE();
        WAIT(20);
        FLD_SE_PLAY(56);
        DIST_BLUR_PARA(60, 175, 2, 0.1f, 0.0f, 0.13f, 0);
        DIST_BLUR_RGBA(132, 132, 132, 101);
        DIST_BLUR_AREA(256, 0, 0);
