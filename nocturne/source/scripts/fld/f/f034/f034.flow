        CAM_PATH_MOVE(SEARCH_ID("01cam_02"), SEARCH_ID("01cam_02_MOTION"));
        WAIT(31);
        BIT_ON(1705);
        BIT_ON(2304);
        CALL_NEXT(1, 34, 502);
        CALL_BATTLE(327);
        return;
    }
}

void 010_01eve_02()
{
    PAD_DISABLE();
    FLD_MODEL_OFF(0, 0, "md_hoji_05", 0);
    var0 = MODEL_PLAYER();
    MODEL_POS(var0, SEARCH_ID("01pos_02"));
    SET_ALLPANEL(0);
    WAIT(40);
    itfMesMngOpenWindow();
    itfMesMngMessage(10) /* BOSS_END */;
    itfMesMngCloseWindow();
    FLD_MODEL_ON(0, 0, "md_hoji_02", 0);
    FLD_MODEL_OFF(0, 0, "md_hoji_01", 1);
    FLD_MODEL_OFF(0, 0, "md_hoji_03", 1);
    WAIT(60);
    FADE_OUT(0, 20);
    WAIT(20);
    PAD_ENABLE();
}

void 010_01eve_03()
{
    while (1)
    {
        if (ACT_WIN_DSP2(9) == 1)
        {
            PAD_DISABLE();
            SET_ALLPANEL(6);
            itfMesMngOpenWindow();
            itfMesMngMessage(12) /* MODORI */;
            local72 = itfMesMngSelect(0);
            if (local72 == 0)
            {
                itfMesMngCloseWindow();
                WAIT(20);
                FLD_SE_PLAY(56);
                FADE_OUT(1, 60);
                WAIT(60);
                if (BIT_CHK(1711) == 1)
                {
                    FLD_CALL_WAPEX(28);
                    return;
                }
                else
                {
                    FLD_CALL_WAPEX(25);
                    return;
                }
            }
            else
            {
                itfMesMngCloseWindow();
                SET_ALLPANEL(7);
                PAD_ENABLE();
                return;
            }
        }
        SYNC();
    }
}

void 031_start()
{
    PAD_DISABLE();
    SET_ALLPANEL(0);
    BGM_VOL_DOWN();
    CAM_SEL(SEARCH_ID("01cam_01"));
    local73 = TEX_LOAD("/fld/f/f034/f034_bg01.tmx");
    TEX_ON(local73);
    FADE_IN(0, 5);
    WAIT(5);
    itfMesMngOpenWindow();
    itfMesMngMessage(38) /* CENTER_DONE */;
    itfMesMngCloseWindow();
    FADE_OUT(0, 15);
    WAIT(15);
    SET_CHASE_CAMERA();
    CAM_SEL(- 1);
    TEX_OFF(local73);
    TEX_CLS(local73);
    BGM_VOL_UP();
    CALL_FIELD2(3, "01pos_05");
    return;
}

