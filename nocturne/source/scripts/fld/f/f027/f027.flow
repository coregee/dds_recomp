        PAD_ENABLE();
    }
}

void 001_01eve_01()
{
    if (BIT_CHK(274) == 0 && BIT_CHK(1877) == 0 && BIT_CHK(1976) && BIT_CHK(1472))
    {
        PAD_DISABLE();
        SET_ALLPANEL(2);
        itfMesMngOpenWindow();
        itfMesMngMessage(20) /* KEHAI: > You can feel the presence of a terrifying demon... */;
        if (itfMesMngSelect(21) /* YES_NO_SEL: Yes. / No. */ == 0)
        {
            itfMesMngMessage(22) /* KEHAI2: > Are you sure? */;
            if (itfMesMngSelect(21) /* YES_NO_SEL: Yes. / No. */ == 0)
            {
                itfMesMngCloseWindow();
                FADE_OUT(0, 15);
                WAIT(15);
                var0 = MODEL_PLAYER();
                MODEL_POS(var0, SEARCH_ID("01pos_10"));
                SET_CHASE_CAMERA();
                CAM_SEL(- 1);
                FADE_IN(0, 15);
                WAIT(15);
                COMM_217(82);
                MODEL_POS(MODEL_DSP(2, 20), SEARCH_ID("01pos_10"));
                MODEL_MOTION2(var0, 12, 3, 15, 3);
                WAIT(80);
                FLD_BGM_FADE();
                CALL_NEXT(1, 27, 743);
                CALL_EVENT(743);
                return;
            }
        }
        itfMesMngMessage(23) /* TRY_RUNAWAY: > ............ */;
        if (GET_MOON16() == 8)
        {
            itfMesMngMessage(25) /* SIPPAI: > It looks like you won't be able to escape... */;
            itfMesMngMessage(27) /* SIPPAI_KOTEN: The flames of the candelabrum burn passionately! You won't escape! */;
        }
        else if (RND(100) > 60)
        {
            itfMesMngMessage(25) /* SIPPAI: > It looks like you won't be able to escape... */;
        }
        else
        {
            itfMesMngMessage(24) /* RUNAWAY: > It looks like you'll be able to get away. */;
            itfMesMngCloseWindow();
            SET_ALLPANEL(3);
            BIT_ON(1877);
            PAD_ENABLE();
            return;
        }
        itfMesMngCloseWindow();
        FADE_OUT(0, 15);
        WAIT(15);
        var0 = MODEL_PLAYER();
        MODEL_POS(var0, SEARCH_ID("01pos_10"));
        SET_CHASE_CAMERA();
        CAM_SEL(- 1);
        FADE_IN(0, 15);
        WAIT(15);
        COMM_217(82);
        MODEL_POS(MODEL_DSP(2, 20), SEARCH_ID("01pos_10"));
        MODEL_MOTION2(var0, 12, 3, 15, 3);
        WAIT(80);
        FLD_BGM_FADE();
        CALL_NEXT(1, 27, 743);
        CALL_EVENT(743);
        return;
    }
}

