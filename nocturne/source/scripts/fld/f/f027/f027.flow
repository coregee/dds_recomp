void 007_puzzle()
{
    PAD_DISABLE();
    FLD_BGM_PLAY(130);
    var0 = MODEL_PLAYER();
    MODEL_MOTION2(var0, 8, 0, 0, 1);
    local36 = MODEL_DSP(3, 17);
    MODEL_POS(local36, SEARCH_ID("01pos_04"));
    FLD_MODEL_LIGHT(local36);
    SET_ALLPANEL(0);
    CAM_SEL_FOVY(SEARCH_ID("01cam_01"));
    itfMesMngOpenWindow();
    if (BIT_CHK(84) && BIT_CHK(86) == 0)
    {
        itfMesMngMessage(8) /* PUZZLE_BOY_DAME: Hey! No playing games right now! */;
        itfMesMngCloseWindow();
        FADE_OUT(0, 30);
        WAIT(30);
        PAD_ENABLE();
    }
    else
    {
        if (BIT_CHK(86) == 1)
        {
            itfMesMngMessage(10) /* PUZZLE_BOY_SHOBO: When the going gets tough, it's best to escape into the world of game... */;
        }
        if (BIT_CHK(1479) == 1)
        {
            if (BIT_CHK(1478) == 1)
            {
                itfMesMngMessage(3) /* PUZZLE_BOY3: Oh, you're back. I don't have anything for you, but... */;
            }
            else
            {
                itfMesMngMessage(1) /* PUZZLE_BOY2: If you can win, I'll give you an insect-like thing. */;
            }
        }
        else
        {
            itfMesMngMessage(0) /* PUZZLE_BOY: What is it? */;
            itfMesMngMessage(1) /* PUZZLE_BOY2: If you can win, I'll give you an insect-like thing. */;
            BIT_ON(1479);
        }
        if (itfMesMngSelect(2) /* PUZZLE_BOY_SEL: You're on! / I have better things to do. */ == 0)
        {
            MODEL_POS(var0, SEARCH_ID("01pos_02"));
            CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
            itfMesMngMessage(4) /* PUZZLE_BOY_YES: You don't have to go along with me, you know? Well, it's okay... */;
            itfMesMngCloseWindow();
            FLD_BGM_FADE();
            CALL_NEXT(1, 27, 1001);
            CALL_PUZZLEBOY(1);
            return;
        }
        else
        {
            MODEL_POS(var0, SEARCH_ID("01pos_02"));
            CAM_SEL_FOVY(SEARCH_ID("01cam_02"));
            itfMesMngMessage(5) /* PUZZLE_BOY_NO: Well, I don't mind. */;
            itfMesMngCloseWindow();
            FADE_OUT(0, 30);
            WAIT(30);
            PAD_ENABLE();
        }
    }
}

void 007_end_pzl()
{
    PAD_DISABLE();
    FLD_BGM_PLAY(130);
    var0 = MODEL_PLAYER();
    MODEL_MOTION2(var0, 8, 0, 0, 1);
    local37 = MODEL_DSP(3, 17);
    MODEL_POS(local37, SEARCH_ID("01pos_04"));
    FLD_MODEL_LIGHT(local37);
    SET_ALLPANEL(0);
    CAM_SEL_FOVY(SEARCH_ID("01cam_01"));
    itfMesMngOpenWindow();
    if (BIT_CHK(1477) == 1)
    {
        if (BIT_CHK(1478) == 0)
        {
            itfMesMngMessage(7) /* PUZZLE_BOY_WIN: Ummm... So... */;
            itfMesMngMessage(9) /* PUZZLE_BOY_WIN2: > You obtained the Magatama Geis. */;
            prm_DH_PLUS(13);
            itfMesMngMessage(6) /* PUZZLE_BOY_END: You can come again, you know. */;
            BIT_ON(1478);
        }
        else
        {
            itfMesMngMessage(6) /* PUZZLE_BOY_END: You can come again, you know. */;
        }
    }
    else
    {
        itfMesMngMessage(6) /* PUZZLE_BOY_END: You can come again, you know. */;
    }
    itfMesMngCloseWindow();
    FADE_OUT(0, 30);
    WAIT(30);
    PAD_ENABLE();
}

