                    DIST_BLUR_RGBA(132, 132, 132, 101);
                    DIST_BLUR_AREA(256, 0, 0);
                    DIST_BLUR_ON(30);
                    itfMesMngMessage(58) /* BOTTAKURI_YES_04: Are you feeling better? Here's some more... */;
                    prm_PARTY_KAIFUKU();
                    WAIT(10);
                    prm_PARTY_KAIFUKU();
                    itfMesMngMessage(59) /* BOTTAKURI_YES_05: > Your party recovered some more. */;
                    DIST_BLUR_PARA(60, 176, 15, 0.222f, 0.005f, 0.13f, 0);
                    DIST_BLUR_RGBA(132, 132, 132, 101);
                    DIST_BLUR_AREA(256, 0, 0);
                    COMM_128(30);
                    WAIT(30);
                    itfMesMngMessage(60) /* BOTTAKURI_YES_06: ...Have... another... drink... */;
                    WAIT(30);
                    itfMesMngMessage(60) /* BOTTAKURI_YES_06: ...Have... another... drink... */;
                    COMM_139(- 3000);
                    FADE_OUT(1, 30);
                    WAIT(30);
                    itfMesMngCloseWindow();
                    DIST_BLUR_OFF(0);
                    CAM_SEL(SEARCH_ID("01cam_03"));
                    FADE_IN(0, 10);
                    WAIT(10);
                    itfMesMngOpenWindow();
                    itfMesMngMessage(61) /* BOTTAKURI_YES_07: > Your wallet feels really light... */;
                    itfMesMngCloseWindow();
                    FADE_OUT(0, 30);
                    WAIT(30);
                    FLD_BGM_FADE();
                    FLD_CALL_WAPEX(79);
                    return;
                }
            }
            itfMesMngCloseWindow();
            FLD_BGM_FADE();
            FLD_BGM_PLAY(1);
            SET_ALLPANEL(7);
            SET_CHASE_CAMERA();
            PAD_ENABLE();
        }
        SYNC();
    }
}

void 013_01npc_02()
{
    while (1)
    {
        if (ACT_WIN_DSP(1))
        {
            PAD_DISABLE();
            SET_NPC_CAMERA("01npc_02");
            SET_ALLPANEL(6);
            FLD_BGM_FADE();
            FLD_BGM_PLAY(136);
            local43 = prm_PLAYER_GET_LEVEL();
            if (local43 > 30)
            {
                WAIT(1);
                if (BIT_CHK(308) == 0)
                {
                    WAIT(1);
                    if (prm_STOCK_FULL_CHECK() == 0)
                    {
                        local44 = 30000;
                        itfMesMngOpenWindow();
                        itfMesMngMessage(135) /* F041_SINEN_LEV001: ...You're pretty strong. */;
                        if (prm_DV_CHECK(124) == 0)
                        {
                            itfMesMngMessage(138) /* F041_SINEN_LEV003: Here's what I'm selling... */;
                            if (itfMesMngSelect(139) /* F041_SINEN_LEV003_SEL: Alright, I'll buy it. / No thanks. */ == 0)
                            {
                                local44 = 30000;
                                if (prm_MAKA_CHECK(local44) == 0)
                                {
                                    itfMesMngMessage(145) /* F041_SINEN_KANE: Hey-hey-hey, you don't have enough Macca! */;
                                    itfMesMngCloseWindow();
                                    goto END;
                                }
                                else
                                {
                                    itfMesMngMessage(140) /* F041_SINEN_LEV004: Excellent choice! */;
                                    itfMesMngMessage(141) /* F041_SINEN_LEV005: > You purchased a demon from the Shady Broker. */;
                                    itfMesMngCloseWindow();
                                    prm_DV_PLUS(124, 2, 0);
                                    prm_DV_COPY_PARAM(124, 209);
                                    BIT_ON(308);
                                    COMM_139(-local44);
                                    goto END;
                                }
                                WAIT(1);
                            }
                            itfMesMngMessage(144) /* F041_SINEN_LEVIRANAI: That's fine. If you change your mind, feel free to come back anytime. */;
                            itfMesMngCloseWindow();
                            goto END;
                        }
                        WAIT(1);
                        itfMesMngOpenWindow();
                        itfMesMngMessage(136) /* F041_SINEN_DAM: ...On second thought, forget what I just said. */;
                        itfMesMngCloseWindow();
                        goto END;
                        WAIT(1);
                    }
                    itfMesMngOpenWindow();
                    itfMesMngMessage(137) /* F041_SINEN_LEV002: ...You're pretty strong. */;
                    itfMesMngCloseWindow();
                    goto END;
                }
                WAIT(1);
            }
            if (BIT_CHK(308) == 0)
            {
                itfMesMngOpenWindow();
                itfMesMngMessage(133) /* F041_SINEN_X: ...I'm glad you made it here. */;
                itfMesMngCloseWindow();
            }
            else
            {
                itfMesMngOpenWindow();
                itfMesMngMessage(134) /* F041_SINEN_X2: ...I've got nothing else to sell you. ...Hey, don't worry. */;
                itfMesMngCloseWindow();
            }
        END:
            FLD_BGM_FADE();
            FLD_BGM_PLAY(1);
            SET_ALLPANEL(7);
            SET_CHASE_CAMERA();
            PAD_ENABLE();
        }
        SYNC();
    }
}

