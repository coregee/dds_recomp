void 012_01npc_01()
{
    while (1)
    {
        if (ACT_WIN_DSP(1))
        {
            PAD_DISABLE();
            SET_NPC_CAMERA("01npc_01");
            SET_ALLPANEL(6);
            FLD_BGM_FADE();
            FLD_BGM_PLAY(134);
            itfMesMngOpenWindow();
            itfMesMngMessage(120) /* F041_AREA9_KUROJAKU: It's natural for every living thing to die... Treatment, therefore, c... */;
            if (itfMesMngSelect(121) /* F041_AREA9_DR_SEL: No. / Yes. */ == 0)
            {
                itfMesMngMessage(122) /* F041_AREA9_KUROJAKU_YES: Good. One lives, one dies... That's the way it should be. */;
            }
            else
            {
                if (BIT_CHK(150))
                {
                    local42 = 20000;
                }
                else if (BIT_CHK(86))
                {
                    local42 = 15000;
                }
                else if (BIT_CHK(63))
                {
                    local42 = 10000;
                }
                else if (BIT_CHK(1472))
                {
                    local42 = 5000;
                }
                else
                {
                    local42 = 2000;
                }
                itfMesMngSetVarScr(0, local42, 0);
                itfMesMngMessage(123) /* F041_AREA9_KUROJAKU_KAIH: ...I am a doctor, after all. I'll treat your wounds. */;
                if (itfMesMngSelect(121) /* F041_AREA9_DR_SEL: No. / Yes. */ == 0)
                {
                    itfMesMngMessage(122) /* F041_AREA9_KUROJAKU_YES: Good. One lives, one dies... That's the way it should be. */;
                }
                else
                {
                    if (prm_MAKA_CHECK(local42) == 0)
                    {
                        itfMesMngMessage(125) /* F041_AREA9_KUROJAKU_NOMO: ...... */;
                    }
                    else
                    {
                        prm_PARTY_KAIFUKU();
                        itfMesMngMessage(124) /* F041_AREA9_KUROJAKU_KAIH: > ...... */;
                        COMM_139(-local42);
                    }
                }
            }
            itfMesMngCloseWindow();
            FLD_BGM_FADE();
            FLD_BGM_PLAY(1);
            SET_ALLPANEL(7);
            SET_CHASE_CAMERA();
            PAD_ENABLE();
        }
        SYNC();
    }
}

