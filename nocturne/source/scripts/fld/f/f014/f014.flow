void 015_01eve_02()
{
    while (1)
    {
        if (ACT_WIN_DSP(2) == 1)
        {
            if (BIT_CHK(6) == 1)
            {
                PAD_DISABLE();
                itfMesMngOpenWindow();
                itfMesMngMessage(37) /* IRIGUTI: > You feel the presence of someone on the roof. */;
                local43 = itfMesMngSelect(38) /* IRIGUTI_SEL: Yes. / No. */;
                if (local43 == 0)
                {
                    itfMesMngCloseWindow();
                    FADE_OUT(0, 10);
                    WAIT(10);
                    FLD_BGM_FADE();
                    CALL_NEXT(1, 15, 618);
                    CALL_EVENT(618);
                    return;
                }
            }
            else
            {
                PAD_DISABLE();
                itfMesMngOpenWindow();
                itfMesMngMessage(71) /* OKUJOU1: > This door leads to the roof. */;
            }
            itfMesMngCloseWindow();
            PAD_ENABLE();
        }
        SYNC();
    }
}

